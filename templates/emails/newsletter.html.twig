{% apply inline_css %}
<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{{ campaign.subject }}</title>
<style>
    body { margin: 0; background: #f4f1e9; color: #1f2a24; font-family: Georgia, serif; }
    .wrapper { width: 100%; padding: 32px 16px; background: #f4f1e9; }
    .card { max-width: 600px; margin: 0 auto; background: #ffffff; border: 1px solid #d8d2c4; border-radius: 12px; overflow: hidden; }
    .brand { padding: 28px 32px 12px; font-size: 26px; letter-spacing: -0.03em; }
    .accent { color: #bb4527; }
    .content { padding: 0 32px 32px; font-family: Arial, Helvetica, sans-serif; font-size: 15px; line-height: 1.65; color: #3d4a43; }
    .content h1, .content h2, .content h3 { font-family: Georgia, serif; color: #1f2a24; }
    .content a { color: #1c5b45; }
    .footer { padding: 0 32px 28px; font-family: Arial, Helvetica, sans-serif; font-size: 12px; color: #6b7770; }
</style>
</head>
<body>
<div class="wrapper">
<div class="card">
<div class="brand">{{ siteName|lower }}<span class="accent">.</span></div>
<div class="content">{{ campaign.html|raw }}</div>
<div class="footer">You are receiving this because you subscribed to {{ siteName }}. <a href="{{ unsubscribeUrl }}">Unsubscribe</a>.</div>
</div>
</div>
</body>
</html>
{% endapply %}
