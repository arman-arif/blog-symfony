<!DOCTYPE html>
<html lang="en">
<head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>{% block title %}{{ siteName }}{% endblock %}</title></head>
<body style="margin:0;background:#f4f1e9;color:#1f2a24;font-family:Georgia,serif;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f1e9;padding:32px 16px;">
<tr><td align="center">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:560px;background:#ffffff;border:1px solid #d8d2c4;border-radius:12px;overflow:hidden;">
<tr><td style="padding:28px 32px 12px;"><span style="font-size:26px;letter-spacing:-0.03em;">{{ siteName|lower }}<span style="color:#bb4527;">.</span></span></td></tr>
<tr><td style="padding:0 32px 32px;font-family:Arial,Helvetica,sans-serif;font-size:15px;line-height:1.65;color:#3d4a43;">
{% block content %}{% endblock %}
<p style="margin:28px 0 0;font-size:12px;color:#6b7770;">Sent by {{ fromName }}. If you did not expect this email, you can ignore it.</p>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>
