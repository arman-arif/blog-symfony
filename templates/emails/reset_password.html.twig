{% extends 'emails/layout.html.twig' %}
{% block title %}Reset your password{% endblock %}
{% block content %}
<h1 style="margin:0 0 16px;font-family:Georgia,serif;font-size:24px;color:#1f2a24;">Reset your password</h1>
<p>Hello {{ user.displayName }},</p>
<p>We received a request to reset the password for your {{ siteName }} account. Choose a new password using the link below.</p>
<p style="margin:28px 0;"><a href="{{ url('app_reset_password', {token: resetToken.token}) }}" style="display:inline-block;background:#1c5b45;color:#ffffff;text-decoration:none;padding:13px 22px;border-radius:6px;font-weight:bold;">Choose a new password</a></p>
<p>This link expires {{ expiresAt|date('M j, Y H:i') }}. If you did not request a reset, no action is needed.</p>
{% endblock %}
