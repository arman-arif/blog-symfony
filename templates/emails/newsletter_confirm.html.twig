{% extends 'emails/layout.html.twig' %}
{% block title %}Confirm your subscription{% endblock %}
{% block content %}
<h1 style="margin:0 0 16px;font-family:Georgia,serif;font-size:24px;color:#1f2a24;">One small confirmation</h1>
<p>Hello,</p>
<p>Please confirm that you would like to receive the {{ siteName }} Sunday letter. One thoughtful email a week, no noise.</p>
<p style="margin:28px 0;"><a href="{{ confirmUrl }}" style="display:inline-block;background:#1c5b45;color:#ffffff;text-decoration:none;padding:13px 22px;border-radius:6px;font-weight:bold;">Confirm subscription</a></p>
<p>If you did not request this, you can ignore this email or <a href="{{ unsubscribeUrl }}" style="color:#1c5b45;">unsubscribe</a>.</p>
{% endblock %}
