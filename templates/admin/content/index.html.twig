{% extends 'admin/layout.html.twig' %}
{% set titles = {page: 'Static pages', menu: 'Navigation menus', ad: 'Advertisements'} %}
{% block page_title %}{{ titles[module] }}{% endblock %}
{% block breadcrumb %}{{ titles[module] }}{% endblock %}
{% block eyebrow %}Content / {{ titles[module] }}{% endblock %}
{% block heading %}{{ {page: 'The pages behind your journal.', menu: 'A considered path through your site.', ad: 'Partnerships with a little purpose.'}[module] }}{% endblock %}
{% block intro %}{{ {page: 'Edit the evergreen information that readers return to.', menu: 'Arrange links, nest related destinations and choose where each menu belongs.', ad: 'Review placements, creative formats and campaign dates without loading any advertising network.'}[module] }} Fictional records, local-only actions.{% endblock %}
{% block actions %}<twig:Button href="{{ path('admin_' ~ module ~ '_create') }}">New {{ module == 'ad' ? 'advertisement' : module }}</twig:Button>{% endblock %}
{% block content %}<twig:DataTable id="content-table" caption="{{ titles[module] }}" columns="{{ [{key: 'name', label: module == 'page' ? 'Title' : 'Name', sortable: true}, {key: 'detail', label: module == 'page' ? 'Slug' : (module == 'menu' ? 'Location' : 'Placement'), sortable: true}, {key: 'status', label: module == 'menu' ? 'Items' : 'Status', sortable: true}] }}" state="{{ state }}">
{% for item in records %}{% set name = item.name|default(item.title|default('')) %}{% set detail = item.slug|default(item.location|default(item.placement|default(''))) %}<tr data-row data-id="{{ item.id }}" data-name="{{ name }}" data-detail="{{ detail }}" data-status="{{ item.status|default(item.isActive|default(false) ? 'active' : 'inactive') }}" data-search="{{ name }} {{ detail }}"><td><input type="checkbox" data-select-row disabled aria-label="Select {{ name }}"></td><td><a class="font-semibold hover:text-brand" href="{{ path('admin_' ~ module ~ '_edit', {id: item.id}) }}">{{ name }}</a>{% if module == 'ad' %}<p class="mt-1 text-xs text-muted">{{ item.type|title }} · Priority {{ item.priority }}</p>{% endif %}</td><td>{{ detail|replace({'_': ' '})|title }}</td><td>{% if module == 'menu' %}{{ item.items|length }} links{% else %}<twig:Badge tone="{{ item.status|default('') == 'published' or item.isActive|default(false) ? 'success' : 'neutral' }}">{{ item.status|default(item.isActive|default(false) ? 'Enabled' : 'Disabled')|title }}</twig:Badge>{% if module == 'ad' %}<p class="mt-1 whitespace-nowrap text-xs text-muted">{{ item.startsAt|date('M j') }} – {{ item.endsAt|date('M j, Y') }}</p>{% endif %}{% endif %}</td><td><div class="flex gap-2"><twig:Button variant="ghost" size="sm" href="{{ path('admin_' ~ module ~ '_edit', {id: item.id}) }}">Edit</twig:Button><twig:Button variant="ghost" size="sm" data-component="confirm" data-row-remove data-confirm-message="Remove {{ name }} from this local preview only? Nothing is deleted from the server." aria-label="Remove {{ name }} locally"><twig:Icon name="trash" size="16"/></twig:Button></div></td></tr>{% endfor %}</twig:DataTable>{% endblock %}
