{% extends 'admin/layout.html.twig' %}
{% block page_title %}{{ campaign.id ? 'Edit campaign' : 'New campaign' }}{% endblock %}
{% block breadcrumb %}Newsletter / Campaigns / {{ campaign.id ? 'Edit' : 'New' }}{% endblock %}
{% block eyebrow %}Audience / Campaign editor{% endblock %}
{% block heading %}{{ campaign.id ? 'Shape the next letter.' : 'Write something worth opening.' }}{% endblock %}
{% block intro %}Campaign content is sanitized and rendered with inline CSS. Test sends go to one address; real sends use the async queue.{% endblock %}
{% block actions %}<twig:Button variant="secondary" href="{{ path('admin_newsletter_campaigns') }}">All campaigns</twig:Button>{% endblock %}
{% block content %}
{% if form %}
{{ form_start(form, {attr: {novalidate: 'novalidate', 'data-component': 'validate campaign-form'}}) }}
{{ form_errors(form) }}
<twig:AdminFormLayout sidebarTitle="Delivery">
    <div class="space-y-6">
        {{ form_row(form.subject) }}
        <twig:RichEditor id="campaign-content" content="{{ campaign.html }}" outputName="{{ form.html.vars.full_name }}" label="Email content" />
        {{ form_errors(form.html) }}
    </div>
    <twig:block name="sidebar">
        <div class="space-y-6">
            {{ form_row(form.status) }}
            <div data-schedule-panel {% if campaign.status.value != 'scheduled' %}hidden{% endif %}>{{ form_row(form.scheduledAt) }}</div>
            <twig:Button type="submit" class="w-full">Save campaign</twig:Button>
        </div>
    </twig:block>
</twig:AdminFormLayout>
{{ form_widget(form._token) }}
{{ form_end(form, {render_rest: false}) }}
{% else %}
<section class="card p-6"><h2 class="font-display text-2xl">{{ campaign.subject }}</h2><p class="my-4 text-sm text-muted">{{ campaign.status.value|title }} · {{ campaign.stats.sent }} accepted by transport · {{ campaign.stats.failed }} failed · {{ campaign.stats.skipped }} skipped · {{ campaign.stats.uncertain }} uncertain. Queued content is read-only.</p><div class="prose">{{ campaign.html|raw }}</div></section>
{% endif %}
{% if campaign.id %}
<div class="mt-6 grid gap-5 lg:grid-cols-2">
    <section class="card p-5" aria-labelledby="campaign-test-heading">
        <h2 id="campaign-test-heading" class="font-display text-2xl">Test send</h2>
        <p class="mt-1 text-sm text-muted">Deliver this campaign to one test address only.</p>
        <form method="post" action="{{ path('admin_newsletter_test', {id: campaign.id}) }}" class="mt-4 space-y-3"><input type="hidden" name="_token" value="{{ csrf_token('campaign_test') }}"><div><label class="field-label" for="campaign-test-email">Test recipient</label><input class="field-control" id="campaign-test-email" type="email" name="email" required placeholder="you@example.test"></div><twig:Button type="submit" variant="secondary">Send test</twig:Button></form>
    </section>
    <section class="card p-5" aria-labelledby="campaign-send-heading">
        <h2 id="campaign-send-heading" class="font-display text-2xl">Send campaign</h2>
        {% if campaign.editable %}
            <p class="mt-1 text-sm text-muted">Queue this letter for every confirmed subscriber. Batches are processed asynchronously.</p>
            <form method="post" action="{{ path('admin_newsletter_send', {id: campaign.id}) }}" class="mt-4"><input type="hidden" name="_token" value="{{ csrf_token('campaign_send') }}"><twig:Button type="submit">Send to confirmed subscribers</twig:Button></form>
        {% else %}
            <p class="mt-1 text-sm text-muted">This campaign is queued or completed. Delivery statistics appear on the campaign list. Failed or uncertain attempts are not automatically resent.</p>
        {% endif %}
    </section>
</div>
{% endif %}
{% include 'admin/media/picker.html.twig' with {media: []} %}
{% include 'admin/article/editor_dialogs.html.twig' %}
{% endblock %}
