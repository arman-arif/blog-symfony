{% extends 'admin/layout.html.twig' %}
{% block page_title %}{{ record.id ? 'Edit campaign' : 'New campaign' }}{% endblock %}{% block breadcrumb %}Newsletter / Campaign editor{% endblock %}{% block eyebrow %}Audience / A letter to readers{% endblock %}{% block heading %}Begin a note worth reading.{% endblock %}{% block intro %}Compose an email preview, check a schedule or simulate a test. No recipients are contacted and nothing is saved.{% endblock %}{% block actions %}<twig:Button variant="secondary" href="{{ path('admin_newsletter_campaigns') }}">All campaigns</twig:Button>{% endblock %}
{% block content %}<twig:PreviewStates state="{{ state }}"><twig:PreviewForm data-component="validate content-form campaign-form" successMessage="Campaign validated locally. Nothing was saved, scheduled or sent."><twig:AdminFormLayout sidebarTitle="Delivery settings"><div class="space-y-6"><twig:Field id="campaign-subject" label="Email subject" required><twig:Input id="campaign-subject" name="subject" value="{{ record.subject }}" required minlength="5" maxlength="150" data-slug-source/></twig:Field><twig:RichEditor article="{{ record }}" label="Email content" contentTemplate="admin/newsletter/editor_content.html.twig" outputName="html"/></div><twig:block name="sidebar"><div class="space-y-5"><twig:Field id="campaign-status" label="Status"><twig:Select id="campaign-status" name="status" value="{{ record.status }}" options="{{ {draft: 'Draft', scheduled: 'Scheduled', sent: 'Sent snapshot'} }}"/></twig:Field><twig:Field id="campaign-schedule" label="Scheduled date & time" help="UTC preview; no email worker runs."><twig:Input id="campaign-schedule" name="scheduledAt" type="datetime-local" value="{{ record.scheduledAt ? record.scheduledAt|date('Y-m-d\\TH:i') : '' }}"/></twig:Field><twig:Button variant="secondary" data-content-preview>Preview email locally</twig:Button><twig:Button variant="secondary" data-dialog-open="campaign-test-dialog">Test-email preview</twig:Button><twig:Button type="submit">Validate campaign</twig:Button><p class="text-xs text-muted">Actual delivery, consent checks, batching and email-template processing remain M10.</p></div></twig:block></twig:AdminFormLayout></twig:PreviewForm></twig:PreviewStates>{% include 'admin/media/picker.html.twig' %}{% include 'admin/article/editor_dialogs.html.twig' %}<twig:Modal id="content-preview-dialog" title="Local email preview" class="max-w-3xl"><h2 class="font-display text-3xl" data-content-preview-title></h2><div class="prose prose-stone mt-6 max-w-none dark:prose-invert" data-content-preview-body></div></twig:Modal><twig:Modal id="campaign-test-dialog" title="Test-email simulation"><p class="mb-5 text-sm text-muted">Enter a fictional recipient. This form never sends mail.</p><twig:PreviewForm successMessage="Test-email fields validated. No email was sent."><twig:Field id="campaign-test-email" label="Fictional test recipient" required><twig:Input id="campaign-test-email" type="email" required value="reader@example.test"/></twig:Field><twig:Button type="submit">Simulate test validation</twig:Button></twig:PreviewForm></twig:Modal>{% endblock %}
