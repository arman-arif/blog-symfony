{% extends 'admin/layout.html.twig' %}
{% set history = app.request.attributes.get('_route') == 'admin_newsletter_history' %}
{% block page_title %}{{ history ? 'Campaign history' : 'Newsletter campaigns' }}{% endblock %}{% block breadcrumb %}Newsletter / {{ history ? 'History' : 'Campaigns' }}{% endblock %}{% block eyebrow %}Audience / Editorial letters{% endblock %}{% block heading %}{{ history ? 'A record of notes sent with care.' : 'Something worth opening.' }}{% endblock %}{% block intro %}Drafts, scheduling and past-delivery statistics are illustrative. No email has been sent by this preview.{% endblock %}{% block actions %}<twig:Button href="{{ path('admin_newsletter_create') }}">New campaign</twig:Button>{% endblock %}
{% block content %}{% include 'admin/newsletter/partials/navigation.html.twig' %}<twig:DataTable id="campaigns-table" caption="{{ history ? 'Delivery history' : 'Campaigns' }}" state="{{ state }}" columns="{{ [{key: 'subject', label: 'Subject', sortable: true}, {key: 'status', label: 'Status', sortable: true}, {key: 'sent', label: 'Delivery'}, {key: 'schedule', label: 'Date'}] }}">{% for campaign in records|filter(item => not history or item.status == 'sent') %}<tr data-row data-id="{{ campaign.id }}" data-subject="{{ campaign.subject }}" data-status="{{ campaign.status }}" data-search="{{ campaign.subject }}"><td><input type="checkbox" data-select-row disabled aria-label="Select {{ campaign.subject }}"></td><td><a class="font-semibold text-brand" href="{{ path('admin_newsletter_edit', {id: campaign.id}) }}">{{ campaign.subject }}</a></td><td><twig:Badge tone="{{ campaign.status == 'sent' ? 'success' : 'neutral' }}">{{ campaign.status|title }}</twig:Badge></td><td>{{ campaign.stats.sent }} sent / {{ campaign.stats.failed }} failed <span class="block text-xs text-muted">Illustrative snapshot</span></td><td>{{ campaign.sentAt ? campaign.sentAt|date('M j, Y H:i') : (campaign.scheduledAt ? campaign.scheduledAt|date('M j, Y H:i') : 'Not scheduled') }}</td><td><div class="flex gap-2"><twig:Button variant="ghost" size="sm" href="{{ path('admin_newsletter_edit', {id: campaign.id}) }}">Open</twig:Button><twig:Button variant="ghost" size="sm" data-component="confirm" data-row-remove data-confirm-message="Remove this local campaign row? No campaign is deleted or cancelled.">Remove</twig:Button></div></td></tr>{% endfor %}</twig:DataTable>{% endblock %}
