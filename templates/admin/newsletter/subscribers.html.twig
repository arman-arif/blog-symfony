{% extends 'admin/layout.html.twig' %}
{% block page_title %}Newsletter subscribers{% endblock %}{% block breadcrumb %}Newsletter / Subscribers{% endblock %}{% block eyebrow %}Audience / Newsletter{% endblock %}{% block heading %}A thoughtful note, a willing audience.{% endblock %}{% block intro %}Fictional subscription records. Local status changes do not subscribe anyone or alter consent. The export button shows sample CSV only.{% endblock %}
{% block content %}{% include 'admin/newsletter/partials/navigation.html.twig' %}<div data-component="system-actions"><twig:Button variant="secondary" class="mb-5" data-export-preview disabled>Preview subscriber export</twig:Button><twig:DataTable id="subscribers-table" caption="Subscribers" state="{{ state }}" columns="{{ [{key: 'email', label: 'Email', sortable: true}, {key: 'status', label: 'Status', sortable: true}, {key: 'updated', label: 'Joined', sortable: true}] }}" filters="{{ [{key: 'status', label: 'Statuses', options: [{value: 'active', label: 'Active'}, {value: 'inactive', label: 'Inactive (local)'}, {value: 'unconfirmed', label: 'Unconfirmed'}, {value: 'unsubscribed', label: 'Unsubscribed'}]}] }}">{% for subscriber in records %}<tr data-row data-id="{{ subscriber.id }}" data-email="{{ subscriber.email }}" data-status="{{ subscriber.status }}" data-updated="{{ subscriber.createdAt|date('U') }}" data-search="{{ subscriber.email }}"><td><input type="checkbox" data-select-row disabled aria-label="Select {{ subscriber.email }}"></td><td>{{ subscriber.email }}</td><td><span data-local-status-label class="badge badge-neutral">{{ subscriber.status|title }}</span></td><td>{{ subscriber.createdAt|date('M j, Y') }}</td><td><div class="flex gap-2"><button type="button" class="btn btn-secondary btn-sm" data-toggle-local-status disabled>Toggle active</button><twig:Button variant="ghost" size="sm" data-component="confirm" data-row-remove data-confirm-message="Remove this fictional subscription from the local preview only? Nothing is stored.">Remove</twig:Button></div></td></tr>{% endfor %}</twig:DataTable></div><twig:Modal id="export-preview-dialog" title="Subscriber CSV preview"><p class="mb-4 text-xs text-muted">All fictional fixture rows, irrespective of table filters. No file was exported or sent.</p><pre class="max-h-80 overflow-auto text-xs" data-export-content></pre></twig:Modal>{% endblock %}
