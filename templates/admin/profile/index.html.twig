{% extends 'admin/layout.html.twig' %}
{% block page_title %}My profile{% endblock %}
{% block breadcrumb %}My profile{% endblock %}
{% block eyebrow %}Workspace / Your account{% endblock %}
{% block heading %}The person behind the perspective.{% endblock %}
{% block intro %}Try profile, password and two-factor setup controls using fictional information only. No identity, credential or security setting changes.{% endblock %}
{% block content %}<twig:PreviewStates state="{{ state }}">
<div class="space-y-6">
<twig:PreviewForm data-component="validate content-form" successMessage="Profile validated locally. No identity or email was changed."><twig:AdminFormLayout sidebarTitle="Your public identity"><div class="space-y-5"><twig:Field id="profile-name" label="Display name" required><twig:Input id="profile-name" name="displayName" value="{{ record.displayName }}" required minlength="2" maxlength="100"/></twig:Field><twig:Field id="profile-email" label="Email" required><twig:Input id="profile-email" name="email" type="email" value="{{ record.email }}" required/></twig:Field><twig:Field id="profile-job" label="Job title"><twig:Input id="profile-job" name="jobTitle" value="{{ record.jobTitle }}" maxlength="100"/></twig:Field><twig:Field id="profile-bio" label="Biography"><twig:Textarea id="profile-bio" name="bio" value="{{ record.bio }}" rows="5" maxlength="1000"/></twig:Field><twig:Button type="submit">Validate profile</twig:Button></div><twig:block name="sidebar"><div class="space-y-5"><twig:Avatar name="{{ record.displayName }}" size="lg"/><p class="text-sm font-semibold">{{ record.roles[0].name }}</p><twig:MediaField label="Avatar" target="profile-avatar" name="avatar"/><p class="text-xs text-muted">Last login {{ record.lastLoginAt|date('M j, Y') }} · fictional account</p></div></twig:block></twig:AdminFormLayout></twig:PreviewForm>
<section class="card p-6" aria-labelledby="password-heading"><h2 id="password-heading" class="mb-4 text-xl font-semibold">Password preview</h2><p class="mb-5 text-sm text-muted">Do not use a real password. Dummy values are cleared after local validation. No password is sent or stored.</p><twig:PreviewForm data-component="validate settings-preview" successMessage="Password fields validated locally and cleared. No password was changed."><div class="grid gap-5 md:grid-cols-3"><twig:Field id="password-current" label="Current dummy password" required><twig:Input id="password-current" name="currentPassword" type="password" required autocomplete="new-password" data-sensitive-preview/></twig:Field><twig:Field id="password-new" label="New dummy password" required help="At least 12 characters; actual strength/breach validation is backend scope."><twig:Input id="password-new" name="newPassword" type="password" required minlength="12" autocomplete="new-password" data-sensitive-preview/></twig:Field><twig:Field id="password-confirm" label="Confirm dummy password" required><twig:Input id="password-confirm" name="confirmPassword" type="password" required autocomplete="new-password" data-password-confirm="password-new" data-sensitive-preview/></twig:Field></div><twig:Button type="submit">Validate password preview</twig:Button></twig:PreviewForm></section>
<section id="two-factor" class="card scroll-mt-24 p-6" aria-labelledby="two-factor-heading"><h2 id="two-factor-heading" class="text-xl font-semibold">Two-factor authentication</h2><p class="mt-3 text-sm text-muted">Not configured · mock status. This setup screen uses a QR placeholder, not an enrollment code or secret.</p><div class="mt-5 grid gap-6 sm:grid-cols-[10rem_minmax(0,1fr)]"><div class="flex aspect-square items-center justify-center rounded-control border-2 border-dashed border-line bg-canvas text-center text-sm font-semibold" role="img" aria-label="QR code placeholder, not scannable">QR placeholder<br>Not scannable</div><div><ol class="list-inside list-decimal space-y-3 text-sm"><li>Open your authenticator app after real enrollment is implemented.</li><li>Scan the real QR code provided by M4, never this placeholder.</li><li>Try a six-digit dummy code below to preview validation.</li></ol><div class="mt-5"><twig:PreviewForm data-component="validate settings-preview" successMessage="Two-factor setup validated locally. 2FA remains inactive; no secret or recovery codes were generated."><twig:Field id="two-factor-code" label="Dummy verification code" required><twig:Input id="two-factor-code" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" required autocomplete="off" data-sensitive-preview/></twig:Field><twig:Button type="submit">Simulate 2FA setup</twig:Button><button type="button" class="btn btn-secondary" disabled title="Real 2FA must be enabled in M4">Recovery codes · unavailable</button></twig:PreviewForm></div></div></div></section>
</div></twig:PreviewStates>{% include 'admin/media/picker.html.twig' %}{% endblock %}
