<section class="card min-w-0 p-5 sm:p-6" data-component="charts" data-chart-type="{{ type }}" data-chart-labels="{{ chart.labels|json_encode }}" data-chart-values="{{ chart.values|json_encode }}">
    <h2 class="text-lg font-semibold" id="{{ id }}-title">{{ title }}</h2><p class="mt-2 text-xs text-muted">{{ subtitle }}</p>
    <div class="relative mt-5 h-60"><canvas id="{{ id }}" role="img" aria-labelledby="{{ id }}-title" aria-describedby="{{ id }}-table"><p>Chart values are available in the table below.</p></canvas></div>
    <details class="mt-4"><summary class="cursor-pointer text-xs font-semibold text-brand">View chart data</summary><table id="{{ id }}-table" class="mt-3 w-full text-left text-xs"><caption class="sr-only">{{ title }} data</caption><thead><tr><th scope="col" class="py-2">{{ type == 'line' ? 'Date' : 'Category' }}</th><th scope="col" class="py-2">{{ unit }}</th></tr></thead><tbody>{% for label in chart.labels %}<tr class="border-t border-line"><th scope="row" class="py-2 font-normal">{{ label }}</th><td>{{ chart.values[loop.index0]|number_format }}</td></tr>{% endfor %}</tbody></table></details>
</section>
