{% set route = app.request.attributes.get('_route') %}
{% set groups = [
    {name: 'Workspace', items: [{label: 'Dashboard', route: 'admin_dashboard_index', icon: 'grid', permission: 'admin.access'}, {label: 'Articles', route: 'admin_article_index', icon: 'edit', permission: 'article.create'}]},
    {name: 'Content', items: [{label: 'Categories', route: 'admin_category_index', icon: 'list', permission: 'category.manage'}, {label: 'Tags', route: 'admin_tag_index', icon: 'list', permission: 'tag.manage'}, {label: 'Media library', route: 'admin_media_index', icon: 'image', permission: 'media.upload'}, {label: 'Comments', route: 'admin_comment_index', icon: 'mail', permission: 'comment.moderate'}, {label: 'Static pages', route: 'admin_page_index', icon: 'copy', permission: 'page.manage'}, {label: 'Navigation menus', route: 'admin_menu_index', icon: 'menu', permission: 'menu.manage'}, {label: 'Advertisements', route: 'admin_ad_index', icon: 'image', permission: 'ad.manage'}]},
    {name: 'Audience', items: [{label: 'Newsletter', route: 'admin_newsletter_index', icon: 'mail', permission: 'newsletter.manage'}, {label: 'Analytics', route: 'admin_analytics_index', icon: 'chart', permission: 'analytics.view'}, {label: 'Users', route: 'admin_user_index', icon: 'user', permission: 'user.manage'}]},
    {name: 'System', items: [{label: 'Roles', route: 'admin_role_index', icon: 'user', permission: 'role.manage'}, {label: 'Permissions', route: 'admin_permission_index', icon: 'check', permission: 'permission.manage'}, {label: 'Appearance', route: 'admin_appearance_index', icon: 'sun', permission: 'settings.appearance.manage'}, {label: 'SEO', route: 'admin_seo_index', icon: 'search', permission: 'settings.seo.manage'}, {label: 'General settings', route: 'admin_settings_index', icon: 'settings', permission: 'settings.general.manage'}, {label: 'SMTP', route: 'admin_settings_smtp', icon: 'mail', permission: 'settings.smtp.manage'}, {label: 'Activity logs', route: 'admin_activity_index', icon: 'clock', permission: 'activity_log.view'}, {label: 'My profile', route: 'app_profile', icon: 'user'}]}
] %}
<nav aria-label="{{ mobile ? 'Mobile admin' : 'Admin' }} navigation" class="space-y-5 {{ mobile ? '' : 'admin-navigation' }} p-4">
{% for group in groups %}<div><p class="admin-group-label mb-2 px-3 text-[10px] font-bold uppercase tracking-widest text-muted">{{ group.name }}</p><div class="space-y-1">{% for item in group.items %}{% if item.permission is not defined or is_granted(item.permission) %}<a href="{{ path(item.route) }}" class="admin-nav-item {{ route starts with item.route|replace({'_index': ''}) ? 'bg-brand/10 text-brand' : 'text-muted hover:bg-canvas hover:text-ink' }}" {% if route starts with item.route|replace({'_index': ''}) %}aria-current="page"{% endif %} title="{{ item.label }}"><twig:Icon name="{{ item.icon }}"/><span class="admin-nav-label">{{ item.label }}</span></a>{% endif %}{% endfor %}</div></div>{% endfor %}
</nav>
