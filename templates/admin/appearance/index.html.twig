{% extends 'admin/layout.html.twig' %}
{% block page_title %}Appearance{% endblock %}
{% block breadcrumb %}Settings / Appearance{% endblock %}
{% block eyebrow %}System / Visual identity{% endblock %}
{% block heading %}Make it unmistakably yours.{% endblock %}
{% block intro %}Explore colors and layout in a small, isolated sample. The workspace, public website and stored theme preference remain unchanged.{% endblock %}
{% block content %}{% include 'admin/settings/partials/navigation.html.twig' %}
<twig:PreviewStates state="{{ state }}"><twig:PreviewForm data-component="validate appearance-preview" successMessage="Appearance validated locally. No public layout or preference was saved.">
<twig:AdminFormLayout sidebarTitle="Local appearance sample">
<div class="space-y-6">
<div class="grid gap-5 sm:grid-cols-2">{% for key, label in {primary: 'Primary color', secondary: 'Secondary color'} %}<twig:Field id="appearance-{{ key }}" label="{{ label }}"><twig:Input id="appearance-{{ key }}" name="{{ key }}" type="color" value="{{ settings.appearance[key] }}" data-preview-color="{{ key }}"/></twig:Field>{% endfor %}</div>
<p class="text-xs text-muted" role="status" data-color-contrast>Color contrast is calculated locally after JavaScript loads.</p>
<div class="grid gap-5 sm:grid-cols-2">
<twig:Field id="appearance-header" label="Header layout"><twig:Select id="appearance-header" name="header" value="{{ settings.appearance.header }}" options="{{ {editorial: 'Editorial', compact: 'Compact'} }}"/></twig:Field>
<twig:Field id="appearance-footer" label="Footer layout"><twig:Select id="appearance-footer" name="footer" value="{{ settings.appearance.footer }}" options="{{ {columns: 'Four columns', minimal: 'Minimal'} }}"/></twig:Field>
<twig:Field id="appearance-theme" label="Default light/dark mode"><twig:Select id="appearance-theme" name="theme" value="{{ settings.appearance.theme }}" options="{{ {light: 'Light', dark: 'Dark', system: 'Follow reader preference'} }}"/></twig:Field>
<twig:Field id="appearance-sidebar" label="Article sidebar"><twig:Select id="appearance-sidebar" name="sidebar" value="{{ settings.appearance.sidebar }}" options="{{ {related: 'Related reading', newsletter: 'Newsletter invitation', none: 'No sidebar'} }}"/></twig:Field>
</div>
<twig:Field id="appearance-footerText" label="Footer text"><twig:Textarea id="appearance-footerText" name="footerText" value="{{ settings.appearance.footerText }}" rows="2" maxlength="250"/></twig:Field>
<section aria-labelledby="sections-heading"><h2 id="sections-heading" class="mb-4 text-xl font-semibold">Homepage sections</h2><p class="mb-4 text-xs text-muted">Move with buttons; disable a section to remove it from the sample only.</p>
<ol class="space-y-3" data-appearance-sections>{% for section in settings.appearance.sections %}<li class="flex flex-wrap items-center justify-between gap-3 rounded-control border border-line p-3" data-appearance-section><twig:Choice id="appearance-section-{{ loop.index }}" name="sections[]" value="{{ section }}" label="{{ section }}" checked/><div class="flex gap-2"><button type="button" class="btn btn-secondary btn-sm" data-section-move="up" aria-label="Move {{ section }} up">↑ Up</button><button type="button" class="btn btn-secondary btn-sm" data-section-move="down" aria-label="Move {{ section }} down">↓ Down</button></div></li>{% endfor %}</ol>
<p class="mt-3 text-xs text-muted" role="status" data-section-status></p></section>
<section class="space-y-5" aria-labelledby="social-heading"><h2 id="social-heading" class="text-xl font-semibold">Social links</h2>{% for label, url in settings.appearance.socialLinks %}<twig:Field id="appearance-social-{{ loop.index }}" label="{{ label }} URL" help="HTTP(S) links only; no external site is contacted."><twig:Input id="appearance-social-{{ loop.index }}" name="socialLinks[{{ label }}]" type="url" value="{{ url }}" data-safe-url/></twig:Field>{% endfor %}</section>
<twig:Button type="submit">Validate appearance</twig:Button>
</div><twig:block name="sidebar"><section class="rounded-control border border-line p-5" data-appearance-sample aria-label="Isolated theme sample"><header class="border-b border-line pb-4" data-sample-header><span class="font-display text-3xl" data-sample-brand>fieldnotes.</span><p class="mt-2 text-xs" data-sample-layout></p></header><h2 class="mt-5 font-display text-2xl">A little room for curiosity.</h2><p class="mt-3 text-sm">A sample of your editorial identity, never a live website change.</p><p class="mt-4 text-xs" data-sample-accent>Thoughtful stories, made with care.</p><ul class="mt-5 space-y-2 text-xs" data-sample-sections></ul><aside class="mt-4 border-t border-line pt-3 text-xs" data-sample-sidebar></aside><footer class="mt-4 border-t border-line pt-3 text-xs" data-sample-footer></footer></section></twig:block>
</twig:AdminFormLayout></twig:PreviewForm></twig:PreviewStates>{% endblock %}
