{% extends 'admin/layout.html.twig' %}
{% block page_title %}SMTP settings{% endblock %}
{% block breadcrumb %}Settings / SMTP{% endblock %}
{% block eyebrow %}System / Email transport{% endblock %}
{% block heading %}A careful route to the inbox.{% endblock %}
{% block intro %}Fictional email configuration. No connection is made, no credentials are stored and no email is sent. Do not enter real secrets.{% endblock %}
{% block content %}{% include 'admin/settings/partials/navigation.html.twig' %}
<twig:PreviewStates state="{{ state }}">
<twig:PreviewForm data-component="validate settings-preview" successMessage="SMTP settings validated locally. No transport connected and no secrets were stored.">
<twig:AdminFormLayout sidebarTitle="Sender identity">
<div class="space-y-5">
<twig:Alert tone="warning" title="Sensitive settings">Production requires settings.smtp.manage. Saved passwords will never be displayed; encryption and delivery follow in M13.</twig:Alert>
<twig:Field id="smtp-host" label="SMTP host" required><twig:Input id="smtp-host" name="host" value="{{ settings.smtp.host }}" required pattern="([A-Za-z0-9.]|-)+" maxlength="253"/></twig:Field>
<twig:Field id="smtp-port" label="Port" required><twig:Input id="smtp-port" name="port" type="number" value="{{ settings.smtp.port }}" required min="1" max="65535"/></twig:Field>
<twig:Field id="smtp-encryption" label="Encryption"><twig:Select id="smtp-encryption" name="encryption" value="{{ settings.smtp.encryption }}" options="{{ {starttls: 'STARTTLS', tls: 'Implicit TLS', none: 'None · not recommended'} }}"/></twig:Field>
<twig:Field id="smtp-username" label="Username"><twig:Input id="smtp-username" name="username" value="" autocomplete="off"/></twig:Field>
<twig:Field id="smtp-password" label="Password" help="Blank by default. Dummy values are cleared after local validation."><twig:Input id="smtp-password" name="password" type="password" value="" autocomplete="new-password" data-sensitive-preview/></twig:Field>
</div><twig:block name="sidebar"><div class="space-y-5">
<twig:Field id="smtp-fromEmail" label="From email" required><twig:Input id="smtp-fromEmail" name="fromEmail" type="email" value="{{ settings.smtp.fromEmail }}" required/></twig:Field>
<twig:Field id="smtp-fromName" label="From name" required><twig:Input id="smtp-fromName" name="fromName" value="{{ settings.smtp.fromName }}" required maxlength="100"/></twig:Field>
<twig:Field id="smtp-template" label="Email template"><twig:Select id="smtp-template" name="template" options="{{ {editorial: 'Editorial letter', transactional: 'Account notification'} }}"/></twig:Field>
<twig:Button type="submit">Validate SMTP settings</twig:Button><twig:Button variant="secondary" data-dialog-open="smtp-test-dialog">Send test email · preview</twig:Button>
<p class="text-xs text-muted">Email-template processing and transactional delivery remain M10. Selecting a template is local only.</p>
</div></twig:block></twig:AdminFormLayout></twig:PreviewForm></twig:PreviewStates>
<twig:Modal id="smtp-test-dialog" title="Test email preview"><p class="mb-5 text-sm text-muted">Simulate a validation result. No SMTP connection or email delivery occurs.</p><twig:PreviewForm successMessage="Test email preview validated. No email was sent."><twig:Field id="smtp-test-email" label="Fictional recipient" required><twig:Input id="smtp-test-email" type="email" name="recipient" required value="reader@example.test"/></twig:Field><twig:Button type="submit">Simulate test email</twig:Button></twig:PreviewForm></twig:Modal>
{% endblock %}
