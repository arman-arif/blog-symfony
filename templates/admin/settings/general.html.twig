{% extends 'admin/layout.html.twig' %}
{% block page_title %}General settings{% endblock %}
{% block breadcrumb %}Settings / General{% endblock %}
{% block eyebrow %}System / Website essentials{% endblock %}
{% block heading %}Give your journal a sense of place.{% endblock %}
{% block intro %}Website identity and system defaults, presented as local-only controls. Nothing changes the public site or server configuration.{% endblock %}
{% block content %}
{% include 'admin/settings/partials/navigation.html.twig' %}
<twig:PreviewStates state="{{ state }}">
<twig:PreviewForm data-component="validate content-form" successMessage="Settings validated locally. No website or system setting was saved.">
<twig:AdminFormLayout sidebarTitle="Identity & locale">
<div class="space-y-7">
<section class="space-y-5" aria-labelledby="general-heading"><h2 id="general-heading" class="text-xl font-semibold">The essentials</h2>
{% for key, label in {name: 'Website name', tagline: 'Tagline', email: 'Contact email', contact: 'Contact information'} %}
<twig:Field id="general-{{ key }}" label="{{ label }}" required><twig:Input id="general-{{ key }}" name="{{ key }}" type="{{ key == 'email' ? 'email' : 'text' }}" value="{{ settings.general[key] }}" required maxlength="200"/></twig:Field>
{% endfor %}
<twig:Field id="general-description" label="Website description"><twig:Textarea id="general-description" name="description" value="{{ settings.general.description }}" maxlength="500" rows="3"/></twig:Field>
</section>
<section class="space-y-4 rounded-control border border-line p-5" aria-labelledby="system-heading"><h2 id="system-heading" class="text-xl font-semibold">System defaults</h2>
{% for key, label in {registration: 'Allow reader registration', comments: 'Enable comments', anonymousComments: 'Allow anonymous comments', doubleOptIn: 'Require newsletter double opt-in', maintenance: 'Maintenance mode'} %}
<twig:Choice id="system-{{ key }}" name="{{ key }}" label="{{ label }}" type="toggle" checked="{{ settings.system[key] }}"/>
{% endfor %}
<twig:Field id="system-uploadLimit" label="Media upload limit (MB)" help="Preview only; server-side MIME and size validation follow in M6."><twig:Input id="system-uploadLimit" name="uploadLimit" type="number" value="{{ settings.system.uploadLimit }}" required min="1" max="100"/></twig:Field>
<twig:Field id="system-cacheTtl" label="Cache lifetime (seconds)"><twig:Input id="system-cacheTtl" name="cacheTtl" type="number" value="{{ settings.system.cacheTtl }}" required min="0" max="86400"/></twig:Field>
</section>
<section class="space-y-5 rounded-control border border-line p-5" aria-labelledby="code-heading"><h2 id="code-heading" class="text-xl font-semibold">Custom code · restricted capability</h2>
<twig:Alert tone="warning" title="Inert code preview">Custom code requires settings.code.manage in production. Text entered here is never executed or applied.</twig:Alert>
<twig:Field id="system-css" label="Custom CSS"><twig:Textarea id="system-css" name="customCss" value="{{ settings.system.customCss }}" rows="4" maxlength="10000" spellcheck="false"/></twig:Field>
<twig:Field id="system-js" label="Custom JavaScript"><twig:Textarea id="system-js" name="customJavaScript" value="{{ settings.system.customJavaScript }}" rows="4" maxlength="10000" spellcheck="false"/></twig:Field>
</section>
</div>
<twig:block name="sidebar"><div class="space-y-6">
<twig:MediaField image="{{ settings.general.logo }}" label="Logo" target="site-logo" name="logo"/>
<twig:MediaField image="{{ settings.general.favicon }}" label="Favicon" target="site-favicon" name="favicon"/>
<p class="text-xs text-muted">Bundled illustrations stand in for logo/favicon assets. No browser icon is changed.</p>
<twig:Field id="general-timezone" label="Timezone"><twig:Select id="general-timezone" name="timezone" value="{{ settings.general.timezone }}" options="{{ {UTC: 'UTC', 'America/New_York': 'New York', 'Europe/London': 'London', 'Asia/Tokyo': 'Tokyo'} }}"/></twig:Field>
<twig:Field id="general-date" label="Date format"><twig:Select id="general-date" name="dateFormat" value="{{ settings.general.dateFormat }}" options="{{ {'M j, Y': 'Nov 12, 2026', 'Y-m-d': '2026-11-12', 'd/m/Y': '12/11/2026'} }}"/></twig:Field>
<twig:Field id="general-time" label="Time format"><twig:Select id="general-time" name="timeFormat" value="{{ settings.general.timeFormat }}" options="{{ {'H:i': '14:30', 'g:i a': '2:30 pm'} }}"/></twig:Field>
<twig:Field id="general-language" label="Language"><twig:Select id="general-language" name="language" value="{{ settings.general.language }}" options="{{ {en: 'English', fr: 'French', es: 'Spanish'} }}"/></twig:Field>
<twig:Button type="submit">Validate settings</twig:Button>
</div></twig:block>
</twig:AdminFormLayout></twig:PreviewForm></twig:PreviewStates>
{% include 'admin/media/picker.html.twig' %}
{% endblock %}
