{% extends 'admin/layout.html.twig' %}
{% block page_title %}{{ group_label }} settings{% endblock %}
{% block breadcrumb %}Settings / {{ group_label }}{% endblock %}
{% block eyebrow %}System / Website essentials{% endblock %}
{% block heading %}{{ group == 'appearance' ? 'Make the journal feel like yours.' : (group == 'smtp' ? 'Reliable delivery, on your terms.' : (group == 'code' ? 'Trusted code, tightly held.' : 'Give your journal a sense of place.')) }}{% endblock %}
{% block intro %}Changes are persisted, cached for the public site and recorded in the activity log.{% endblock %}
{% block content %}
<nav class="mb-6 flex flex-wrap gap-1 border-b border-line" aria-label="Settings sections">
{% for key, label in groups %}
    {% set permitted = key == 'general' ? is_granted('settings.general.manage') : (key == 'appearance' ? is_granted('settings.appearance.manage') : (key == 'seo' ? is_granted('settings.seo.manage') : (key == 'smtp' ? is_granted('settings.smtp.manage') : is_granted('settings.code.manage')))) %}
    {% if permitted %}<a class="tab" href="{{ path(key == 'appearance' ? 'admin_appearance_index' : (key == 'seo' ? 'admin_seo_index' : (key == 'smtp' ? 'admin_settings_smtp' : (key == 'code' ? 'admin_settings_code' : 'admin_settings_index')))) }}" {% if key == group %}aria-current="page"{% endif %}>{{ label }}</a>{% endif %}
{% endfor %}
</nav>
{% if group == 'smtp' %}
    <twig:Alert tone="info" title="Transport selection" class="mb-6">Choose the environment DSN for local development, or save SMTP credentials. The password is encrypted at rest and never rendered back into this form.</twig:Alert>
{% elseif group == 'code' %}
    <twig:Alert tone="warning" title="Restricted capability" class="mb-6">Custom CSS and JavaScript execute on every public page. Only Super Administrators can edit this group. CSP nonces are added in M14.</twig:Alert>
{% endif %}
<div class="card p-5 sm:p-7">
{{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
{{ form_errors(form) }}
<div class="grid gap-6 lg:grid-cols-2">
{% for field in form %}
    <div class="{{ field.vars.name in ['general_description', 'maintenance_message', 'seo_description', 'seo_robots', 'custom_css', 'custom_js', 'appearance_footer_text', 'appearance_homepage_sections'] ? 'lg:col-span-2' : '' }}">{{ form_row(field) }}</div>
{% endfor %}
</div>
<div class="mt-7 flex items-center gap-3"><twig:Button type="submit">Save {{ group_label|lower }} settings</twig:Button><a class="btn btn-ghost" href="{{ path('admin_dashboard_index') }}">Cancel</a></div>
{{ form_end(form) }}
</div>
{% if group == 'smtp' %}
<section class="card mt-6 p-5 sm:p-7" aria-labelledby="smtp-test-heading">
    <h2 id="smtp-test-heading" class="text-xl font-semibold">Send a test email</h2>
    <p class="mt-2 text-sm text-muted">Uses the saved transport settings above. Test delivery is recorded in application logs but not the campaign history.</p>
    <form method="post" action="{{ path('admin_settings_smtp_test') }}" class="mt-5 flex flex-wrap items-end gap-3">
        <input type="hidden" name="_token" value="{{ csrf_token('smtp_test') }}">
        <div class="min-w-64 flex-1"><label class="field-label" for="smtp-test-email">Recipient</label><input class="field-control" id="smtp-test-email" name="email" type="email" required value="{{ app.user.email }}"></div>
        <twig:Button type="submit" variant="secondary">Send test email</twig:Button>
    </form>
</section>
{% endif %}
{% endblock %}
