{% extends 'admin/layout.html.twig' %}
{% block page_title %}Permissions{% endblock %}
{% block breadcrumb %}Roles / Permissions{% endblock %}
{% block eyebrow %}System / Access{% endblock %}
{% block heading %}See the whole permission map.{% endblock %}
{% block intro %}Each checkbox is enforced server-side by voters. Super Administrator permissions stay complete.{% endblock %}
{% block content %}
<form method="post" action="{{ path('admin_permission_index') }}">
<input type="hidden" name="_token" value="{{ csrf_token('permission_matrix') }}">
<div class="table-shell">
<table class="data-table" aria-label="Role permission matrix">
<thead><tr><th>Permission</th>{% for role in roles %}<th class="text-center">{{ role.name }}</th>{% endfor %}</tr></thead>
<tbody>
{% for group, permissions in groups %}
<tr><th colspan="{{ roles|length + 1 }}" class="bg-canvas text-xs uppercase tracking-wide text-muted">{{ group }}</th></tr>
{% for permission in permissions %}
<tr>
    <th scope="row" class="font-normal"><span class="font-semibold">{{ permission.label }}</span><p class="mt-1 text-xs text-muted"><code>{{ permission.code }}</code></p></th>
    {% for role in roles %}
        <td class="text-center"><input type="checkbox" name="permissions[{{ role.id }}][]" value="{{ permission.code }}" id="permission-{{ role.id }}-{{ permission.id }}" {% if role.hasPermission(permission.code) %}checked{% endif %} {% if role.code == 'ROLE_SUPER_ADMIN' %}disabled{% endif %} aria-label="{{ permission.label }} for {{ role.name }}"></td>
    {% endfor %}
</tr>
{% endfor %}
{% endfor %}
</tbody></table>
</div>
<div class="mt-6 flex items-center justify-between gap-4"><p class="text-xs text-muted">{{ permissionCount }} capabilities across {{ roles|length }} roles. Disabled cells belong to Super Administrator.</p><twig:Button type="submit">Save permission matrix</twig:Button></div>
</form>
{% endblock %}
