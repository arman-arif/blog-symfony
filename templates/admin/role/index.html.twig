{% extends 'admin/layout.html.twig' %}
{% block page_title %}Roles{% endblock %}{% block breadcrumb %}Roles{% endblock %}{% block eyebrow %}System / Access design{% endblock %}{% block heading %}Clear responsibilities, thoughtful access.{% endblock %}{% block intro %}Roles group granular permission strings. These fixture assignments are not enforced authorization.{% endblock %}{% block actions %}<twig:Button variant="secondary" href="{{ path('admin_permission_index') }}">Permission matrix</twig:Button><twig:Button href="{{ path('admin_role_create') }}">New role</twig:Button>{% endblock %}
{% block content %}<twig:DataTable id="roles-table" caption="Roles" state="{{ state }}" columns="{{ [{key: 'name', label: 'Role', sortable: true}, {key: 'description', label: 'Description'}, {key: 'views', label: 'Permissions', sortable: true}, {key: 'users', label: 'Users'}] }}">{% for role in records %}<tr data-row data-id="{{ role.id }}" data-name="{{ role.name }}" data-views="{{ role.permissions|length }}" data-search="{{ role.name }} {{ role.description }}"><td><input type="checkbox" data-select-row disabled aria-label="Select {{ role.name }}"></td><td><a class="font-semibold text-brand" href="{{ path('admin_role_edit', {id: role.id}) }}">{{ role.name }}</a></td><td>{{ role.description }}</td><td>{{ role.permissions|length }}</td><td>{{ role.userCount }} <span class="text-xs text-muted">illustrative</span></td><td><div class="flex gap-2"><twig:Button variant="ghost" size="sm" href="{{ path('admin_role_edit', {id: role.id}) }}">Edit</twig:Button><twig:Button variant="ghost" size="sm" data-component="confirm" data-row-remove data-confirm-message="Remove this role from the local preview only? User access is unchanged.">Remove</twig:Button></div></td></tr>{% endfor %}</twig:DataTable>{% endblock %}
