{% extends 'admin/layout.html.twig' %}
{% block page_title %}Roles{% endblock %}
{% block breadcrumb %}Roles{% endblock %}
{% block eyebrow %}System / Access{% endblock %}
{% block heading %}Give every person the right reach.{% endblock %}
{% block intro %}Roles bundle permission codes. Voters read these permissions; Super Administrator always receives every capability.{% endblock %}
{% block actions %}<twig:Button href="{{ path('admin_role_create') }}">New role</twig:Button>{% endblock %}
{% block content %}
<div class="table-shell"><table class="data-table" aria-label="Roles">
<thead><tr><th>Role</th><th>Code</th><th>Permissions</th><th>Users</th><th>Type</th><th class="text-right">Actions</th></tr></thead>
<tbody>
{% for role in roles %}
<tr>
<td><a class="font-semibold text-brand" href="{{ path('admin_role_edit', {id: role.id}) }}">{{ role.name }}</a><p class="mt-1 max-w-sm text-xs text-muted">{{ role.description }}</p></td>
<td><code class="text-xs">{{ role.code }}</code></td>
<td>{{ role.permissions|length }}</td>
<td>{{ role.users|length }}</td>
<td><span class="badge {{ role.isSystem ? 'badge-info' : 'badge-neutral' }}">{{ role.isSystem ? 'System' : 'Custom' }}</span></td>
<td class="text-right"><twig:Button href="{{ path('admin_role_edit', {id: role.id}) }}" variant="secondary" size="sm">Edit</twig:Button></td>
</tr>
{% endfor %}
</tbody></table></div>
{% endblock %}
