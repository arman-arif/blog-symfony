{% extends 'admin/layout.html.twig' %}
{% block page_title %}{{ role.id ? 'Edit role' : 'New role' }}{% endblock %}
{% block breadcrumb %}Roles / {{ role.id ? role.name : 'New' }}{% endblock %}
{% block eyebrow %}System / Access{% endblock %}
{% block heading %}Define a clear scope of responsibility.{% endblock %}
{% block intro %}Permission changes apply to every user with this role. The Super Administrator role is always kept complete.{% endblock %}
{% block actions %}<twig:Button variant="secondary" href="{{ path('admin_role_index') }}">All roles</twig:Button>{% endblock %}
{% block content %}
<div class="card max-w-4xl p-6 sm:p-8">
{{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
{{ form_errors(form) }}
<div class="grid gap-5 sm:grid-cols-2">{{ form_row(form.name) }}{{ form_row(form.code) }}</div>
<div class="mt-5">{{ form_row(form.description) }}</div>
<fieldset class="mt-6 rounded-control border border-line p-4"><legend class="px-2 text-sm font-semibold">Permissions</legend><div class="max-h-[32rem] space-y-1 overflow-auto">{{ form_row(form.permissions) }}</div></fieldset>
<div class="mt-7"><twig:Button type="submit">Save role</twig:Button></div>
{{ form_end(form) }}
</div>
{% endblock %}
