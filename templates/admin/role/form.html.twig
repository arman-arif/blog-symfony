{% extends 'admin/layout.html.twig' %}
{% block page_title %}{{ record.id ? 'Edit role' : 'New role' }}{% endblock %}{% block breadcrumb %}Roles / {{ record.id ? 'Edit' : 'New' }}{% endblock %}{% block eyebrow %}System / Granular permissions{% endblock %}{% block heading %}Define a role with a clear purpose.{% endblock %}{% block intro %}Choose capabilities for this local preview. These selections never grant or revoke real access.{% endblock %}{% block actions %}<twig:Button variant="secondary" href="{{ path('admin_role_index') }}">All roles</twig:Button>{% endblock %}
{% block content %}<twig:PreviewStates state="{{ state }}"><twig:PreviewForm successMessage="Role validated locally. No permissions were saved or enforced."><div class="card space-y-6 p-6"><twig:Field id="role-name" label="Role name" required><twig:Input id="role-name" name="name" value="{{ record.name }}" required minlength="3" maxlength="100"/></twig:Field><twig:Field id="role-description" label="Description"><twig:Textarea id="role-description" name="description" value="{{ record.description }}" rows="3"/></twig:Field><div class="grid gap-6 md:grid-cols-2">{% for group in ['Workspace', 'Editorial', 'Audience', 'Site', 'System'] %}<fieldset class="rounded-control border border-line p-4"><legend class="px-2 font-semibold">{{ group }}</legend>{% for permission in permissions|filter(item => item.group == group) %}<twig:Choice id="role-permission-{{ permission.code|replace({'.': '-'}) }}" name="permissions[]" value="{{ permission.code }}" label="{{ permission.label }}" checked="{{ permission.code in record.permissions }}"/>{% endfor %}</fieldset>{% endfor %}</div><twig:Button type="submit">Validate role</twig:Button></div></twig:PreviewForm></twig:PreviewStates>{% endblock %}
