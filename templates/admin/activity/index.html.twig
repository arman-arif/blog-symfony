{% extends 'admin/layout.html.twig' %}
{% block page_title %}Activity{% endblock %}
{% block breadcrumb %}Activity{% endblock %}
{% block eyebrow %}System / Audit trail{% endblock %}
{% block heading %}A record of what changed.{% endblock %}
{% block intro %}Read-only audit events with actor, action and context. Logs cannot be edited or deleted from this screen.{% endblock %}
{% block content %}
<form method="get" action="{{ path('admin_activity_index') }}" class="card mb-6 flex flex-wrap items-end gap-3 p-4" role="search">
    <div class="min-w-52 flex-1"><label class="field-label" for="activity-search">Search</label><input class="field-control" id="activity-search" name="q" type="search" value="{{ filters.q }}" placeholder="Action, actor or subject"></div>
    <div><label class="field-label" for="activity-action">Action</label><select class="field-control" id="activity-action" name="action"><option value="">All actions</option>{% for action in actions %}<option value="{{ action }}" {% if filters.action == action %}selected{% endif %}>{{ action }}</option>{% endfor %}</select></div>
    <twig:Button type="submit" variant="secondary">Filter</twig:Button>
</form>
<div class="table-shell"><table class="data-table" aria-label="Activity log">
<thead><tr><th>When</th><th>Actor</th><th>Action</th><th>Subject</th><th>Details</th></tr></thead>
<tbody>
{% for log in activity.items %}
<tr data-activity-row data-action="{{ log.action }}">
    <td class="whitespace-nowrap text-xs text-muted"><time datetime="{{ log.createdAt|date('c') }}">{{ log.createdAt|date('M j, Y H:i') }}</time></td>
    <td>{{ log.user ? log.user.displayName : 'System' }}</td>
    <td><code class="text-xs">{{ log.action }}</code></td>
    <td class="text-xs text-muted">{{ log.subjectType ? log.subjectType ~ (log.subjectId ? ' #' ~ log.subjectId : '') : '—' }}</td>
    <td><details><summary class="cursor-pointer text-xs font-semibold text-brand">Context</summary><pre class="mt-2 max-w-md overflow-auto whitespace-pre-wrap break-words rounded-control bg-canvas p-3 text-xs">{{ log.context|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre></details></td>
</tr>
{% else %}<tr><td colspan="5" class="py-10 text-center text-sm text-muted">No activity matches this filter.</td></tr>{% endfor %}
</tbody></table></div>
{% if activity.pages > 1 %}<nav class="mt-6 flex items-center justify-center gap-2" aria-label="Activity pagination">{% for index in 1..activity.pages %}<a class="btn {{ index == page ? 'btn-primary' : 'btn-secondary' }} btn-sm" href="{{ path('admin_activity_index', {page: index, q: filters.q, action: filters.action}) }}">{{ index }}</a>{% endfor %}</nav>{% endif %}
{% endblock %}
