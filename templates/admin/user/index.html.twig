{% extends 'admin/layout.html.twig' %}
{% block page_title %}Users{% endblock %}{% block breadcrumb %}Users{% endblock %}{% block eyebrow %}System / People{% endblock %}{% block heading %}Good work starts with good people.{% endblock %}{% block intro %}Review the fictional editorial team, role assignments and account status. Local activation does not grant access or change a real account.{% endblock %}
{% block actions %}<twig:Button variant="secondary" href="{{ path('admin_role_index') }}">Roles & permissions</twig:Button><twig:Button href="{{ path('admin_user_create') }}">New user</twig:Button>{% endblock %}
{% block content %}<div data-component="system-actions"><twig:DataTable id="users-table" caption="Users" state="{{ state }}" columns="{{ [{key: 'name', label: 'Name', sortable: true}, {key: 'email', label: 'Email', sortable: true}, {key: 'role', label: 'Role'}, {key: 'status', label: 'Status', sortable: true}] }}" filters="{{ [{key: 'status', label: 'Statuses', options: [{value: 'active', label: 'Active'}, {value: 'inactive', label: 'Inactive'}]}] }}">{% for user in records %}<tr data-row data-id="{{ user.id }}" data-name="{{ user.displayName }}" data-email="{{ user.email }}" data-status="{{ user.isActive ? 'active' : 'inactive' }}" data-search="{{ user.displayName }} {{ user.email }} {{ user.roles[0].name }}"><td><input type="checkbox" data-select-row disabled aria-label="Select {{ user.displayName }}"></td><td><a class="font-semibold text-brand" href="{{ path('admin_user_edit', {id: user.id}) }}">{{ user.displayName }}</a><p class="mt-1 text-xs text-muted">Last login {{ user.lastLoginAt|date('M j, Y') }}</p></td><td>{{ user.email }}</td><td>{{ user.roles[0].name }}</td><td><span data-local-status-label class="badge badge-neutral">{{ user.isActive ? 'Active' : 'Inactive' }}</span></td><td><div class="flex gap-2"><twig:Button variant="ghost" size="sm" href="{{ path('admin_user_edit', {id: user.id}) }}">Edit</twig:Button><button type="button" class="btn btn-secondary btn-sm" data-toggle-local-status disabled>Toggle active</button><twig:Button variant="ghost" size="sm" data-component="confirm" data-row-remove data-confirm-message="Remove this fictional user from the local preview only? No account or access is changed.">Remove</twig:Button></div></td></tr>{% endfor %}</twig:DataTable></div>{% endblock %}
