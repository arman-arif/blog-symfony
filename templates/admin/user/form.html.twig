{% extends 'admin/layout.html.twig' %}
{% block page_title %}{{ creating ? 'New user' : 'Edit user' }}{% endblock %}
{% block breadcrumb %}Users / {{ creating ? 'New' : user.displayName }}{% endblock %}
{% block eyebrow %}System / People{% endblock %}
{% block heading %}{{ creating ? 'Add a new voice.' : 'Keep this account current.' }}{% endblock %}
{% block intro %}Roles and permissions are enforced by voters. Super Administrators cannot be managed by regular administrators.{% endblock %}
{% block actions %}<twig:Button variant="secondary" href="{{ path('admin_user_index') }}">All users</twig:Button>{% endblock %}
{% block content %}
<div class="card max-w-4xl p-6 sm:p-8">
{{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
{{ form_errors(form) }}
<div class="grid gap-6 sm:grid-cols-2">{{ form_row(form.displayName) }}{{ form_row(form.email) }}{{ form_row(form.jobTitle) }}{{ form_row(form.temporaryPassword) }}</div>
<div class="mt-5">{{ form_row(form.bio) }}</div>
<fieldset class="mt-6 rounded-control border border-line p-4"><legend class="px-2 text-sm font-semibold">Roles</legend>{{ form_row(form.assignedRoles) }}</fieldset>
<div class="mt-5 flex flex-wrap gap-6">{{ form_row(form.isActive) }}{{ form_row(form.isVerified) }}</div>
<div class="mt-7 flex gap-3"><twig:Button type="submit">Save user</twig:Button><a class="btn btn-ghost" href="{{ path('admin_user_index') }}">Cancel</a></div>
{{ form_end(form) }}
</div>
{% endblock %}
