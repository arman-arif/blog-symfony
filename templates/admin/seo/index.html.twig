{% extends 'admin/layout.html.twig' %}
{% block page_title %}SEO settings{% endblock %}
{% block breadcrumb %}Settings / Search{% endblock %}
{% block eyebrow %}System / Search visibility{% endblock %}
{% block heading %}Help the right readers find you.{% endblock %}
{% block intro %}Preview search defaults, crawler instructions and redirects. Tracking stays disabled, robots.txt is not changed and no redirect is installed.{% endblock %}
{% block content %}{% include 'admin/settings/partials/navigation.html.twig' %}
<twig:PreviewStates state="{{ state }}">
<twig:PreviewForm data-component="validate content-form settings-preview" successMessage="SEO settings validated locally. No metadata, tracking or crawler configuration was changed.">
<twig:AdminFormLayout sidebarTitle="Sitemap & integrations">
<div class="space-y-6"><twig:SeoFields seo="{{ settings.seo }}" prefix="site"/>
<twig:Field id="seo-canonical" label="Default canonical website URL" help="HTTP(S) only."><twig:Input id="seo-canonical" name="canonicalUrl" type="url" value="{{ settings.seo.canonicalUrl }}" data-safe-url/></twig:Field>
<twig:MediaField label="Default Open Graph image" target="site-og" name="ogImage"/>
<twig:Field id="seo-robots" label="robots.txt editor" help="Plain text only; this preview never serves these instructions."><twig:Textarea id="seo-robots" name="robots" value="{{ settings.seo.robots }}" rows="7" maxlength="10000" spellcheck="false"/></twig:Field>
</div><twig:block name="sidebar"><div class="space-y-5"><h2 class="font-semibold">Sitemap content</h2>
{% for key, label in {sitemapArticles: 'Published, indexable articles', sitemapPages: 'Public static pages', sitemapTaxonomies: 'Categories, tags & authors'} %}<twig:Choice id="seo-{{ key }}" name="{{ key }}" label="{{ label }}" checked="{{ settings.seo[key] }}"/>{% endfor %}
<p class="text-xs text-muted">Private, draft and noindex content must be excluded during M9 integration.</p>
<twig:Field id="seo-ga" label="Google Analytics 4 measurement ID" help="Optional G-… ID. No script is loaded."><twig:Input id="seo-ga" name="gaId" value="{{ settings.seo.gaId }}" pattern="G-[A-Z0-9]+" maxlength="30"/></twig:Field>
<twig:Field id="seo-gsc" label="Search Console verification token" help="Token text only, not a script or HTML snippet."><twig:Input id="seo-gsc" name="gscId" value="{{ settings.seo.gscId }}" pattern="([A-Za-z0-9_]|-)+" maxlength="200"/></twig:Field>
<twig:Button type="submit">Validate search settings</twig:Button></div></twig:block></twig:AdminFormLayout></twig:PreviewForm>
<section class="card mt-6 p-5" data-component="redirect-preview"><div class="mb-5 flex flex-wrap items-center justify-between gap-3"><h2 class="text-xl font-semibold">Redirects</h2><button class="btn btn-secondary" type="button" data-dialog-open="redirect-dialog" disabled data-redirect-add>Add local redirect</button></div><div class="table-shell" tabindex="0" role="region" aria-label="Redirects, scroll horizontally"><table class="data-table min-w-[600px]"><caption class="sr-only">Fictional redirects; no traffic is redirected</caption><thead><tr><th scope="col">Source</th><th scope="col">Destination</th><th scope="col">Status</th><th scope="col">Hits</th><th scope="col">Actions</th></tr></thead><tbody data-redirect-rows>{% for redirect in settings.seo.redirects %}<tr><td>{{ redirect.sourcePath }}</td><td>{{ redirect.targetUrl }}</td><td>{{ redirect.statusCode }}</td><td>{{ redirect.hits }}</td><td><button type="button" class="btn btn-ghost btn-sm" data-component="confirm" data-redirect-remove data-confirm-message="Remove this local redirect row? No server redirect is changed." disabled>Remove</button></td></tr>{% endfor %}</tbody></table></div><p class="mt-3 text-xs text-muted" data-redirect-empty hidden>No local redirect rows. Nothing was changed on the server.</p></section>
</twig:PreviewStates>
<twig:Modal id="redirect-dialog" title="Add a local redirect"><p class="mb-5 text-sm text-muted">A table preview only, not an installed redirect.</p><twig:PreviewForm id="redirect-form" data-component="validate settings-preview" successMessage="Redirect added to the local table only."><twig:Field id="redirect-source" label="Source path" required help="A local path beginning with one slash."><twig:Input id="redirect-source" name="sourcePath" required data-local-path/></twig:Field><twig:Field id="redirect-target" label="Destination" required help="Local path or HTTP(S) URL; no scripts."><twig:Input id="redirect-target" name="targetUrl" required data-safe-url data-allow-path/></twig:Field><twig:Field id="redirect-status" label="HTTP status"><twig:Select id="redirect-status" name="statusCode" options="{{ {'301': '301 · Permanent', '302': '302 · Temporary'} }}"/></twig:Field><twig:Button type="submit">Add to preview</twig:Button></twig:PreviewForm></twig:Modal>
{% include 'admin/media/picker.html.twig' %}
{% endblock %}
