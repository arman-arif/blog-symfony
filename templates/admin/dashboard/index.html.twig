{% extends 'admin/layout.html.twig' %}
{% block page_title %}Dashboard{% endblock %}
{% block actions %}<twig:Button variant="secondary" href="{{ path('admin_article_index', {status: 'draft'}) }}">Review drafts</twig:Button>{% if is_granted('analytics.view') %}<twig:Button href="{{ path('admin_analytics_index') }}">Analytics</twig:Button>{% endif %}{% endblock %}
{% block content %}
{% if dashboard.stats is empty %}
    <twig:EmptyState title="Your first story starts here" description="There are no records yet. Create a story or invite a contributor to begin."><twig:Button href="{{ path('admin_article_create') }}">Create an article</twig:Button></twig:EmptyState>
{% else %}
<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">{% for stat in dashboard.stats %}<twig:StatCard label="{{ stat.label }}" value="{{ stat.value }}" icon="{{ stat.icon }}" note="{{ stat.note }}" data-dashboard-stat="{{ loop.index }}"/>{% endfor %}</div>
{% if is_granted('analytics.view') %}<div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
    {% include 'admin/partials/chart.html.twig' with {id: 'views-chart', title: 'A growing conversation', subtitle: 'Article views · last 7 days from daily rollups', type: 'line', chart: dashboard.views, unit: 'views'} %}
    {% include 'admin/partials/chart.html.twig' with {id: 'categories-chart', title: 'What readers explore', subtitle: 'Category share · last 30 days', type: 'doughnut', chart: dashboard.categories, unit: '%'} %}
</div>
{% endif %}
<div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
<section class="card min-w-0 p-5 sm:p-6">
    <div class="mb-5 flex items-center justify-between gap-4"><h2 class="text-lg font-semibold">On the editorial desk</h2><a href="{{ path('admin_article_index') }}" class="text-xs font-semibold text-brand">All articles ↗</a></div>
    <div class="space-y-1">
        {% for article in dashboard.recentArticles %}
            <div class="flex flex-wrap items-center gap-3 border-b border-line py-4 last:border-0">
                {% if article.featuredImage %}<img class="h-14 w-16 rounded-control object-cover" src="{{ media_url(article.featuredImage, 'thumbnail') }}" alt="" width="64" height="56" loading="lazy">{% else %}<div class="h-14 w-16 rounded-control bg-canvas"></div>{% endif %}
                <div class="min-w-0 flex-1"><a class="block text-sm font-semibold hover:text-brand" href="{{ path('admin_article_edit', {id: article.id}) }}">{{ article.title }}</a><p class="mt-1 text-xs text-muted">{{ article.author.displayName }} · Updated {{ article.updatedAt|date('M j') }}</p></div>
                <twig:Badge tone="{{ article.status.value == 'scheduled' ? 'info' : (article.status.value == 'pending_review' ? 'warning' : 'neutral') }}">{{ article.status.value|replace({'_': ' '})|title }}</twig:Badge>
            </div>
        {% else %}<p class="py-6 text-sm text-muted">No articles yet.</p>{% endfor %}
    </div>
</section>
{% if is_granted('comment.moderate') %}<section id="recent-comments" class="card scroll-mt-24 p-5 sm:p-6">
    <div class="flex items-center justify-between gap-4"><h2 class="text-lg font-semibold">Reader conversations</h2><a class="text-xs font-semibold text-brand" href="{{ path('admin_comment_index') }}">Moderation queue ↗</a></div>
    <div class="mt-5 space-y-5">
        {% for comment in dashboard.comments %}
            <article class="border-b border-line pb-5 last:border-0">
                <div class="flex items-center justify-between gap-3"><p class="text-sm font-semibold">{{ comment.authorName }}</p><twig:Badge tone="{{ comment.status.value == 'pending' ? 'warning' : (comment.status.value == 'approved' ? 'success' : 'neutral') }}">{{ comment.status.value|title }}</twig:Badge></div>
                <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-muted">{{ comment.content }}</p>
                <p class="mt-3 text-xs text-muted"><a class="font-semibold text-brand" href="{{ path('admin_article_edit', {id: comment.article.id}) }}">{{ comment.article.title }}</a> · {{ comment.createdAt|date('M j, Y') }}</p>
            </article>
        {% else %}<p class="py-6 text-sm text-muted">No comments yet.</p>{% endfor %}
    </div>
</section>
{% endif %}
</div>
<div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
{% if is_granted('activity_log.view') %}<section class="card p-5 sm:p-6">
    <div class="flex items-center justify-between gap-4"><h2 class="mb-5 text-lg font-semibold">Around the workspace</h2><a class="text-xs font-semibold text-brand" href="{{ path('admin_activity_index') }}">Full log ↗</a></div>
    <ol class="space-y-5">
        {% for log in dashboard.activity %}
            <li class="flex gap-3"><span class="mt-1 rounded-full bg-brand/10 p-2 text-brand"><twig:Icon name="clock" size="16"/></span><div><p class="text-sm">{{ log.context.summary|default(log.action) }}</p><p class="mt-1 text-xs text-muted">{{ log.user ? log.user.displayName : 'System' }} · <time datetime="{{ log.createdAt|date('c') }}">{{ log.createdAt|date('M j, H:i') }}</time></p></div></li>
        {% else %}<li class="text-sm text-muted">No recorded activity yet.</li>{% endfor %}
    </ol>
</section>
{% endif %}
<section class="card p-5 sm:p-6">
    <h2 class="text-lg font-semibold">Make room for what’s next</h2>
    <p class="mt-3 text-sm leading-relaxed text-muted">{{ dashboard.statuses.draft }} drafts in progress, {{ dashboard.statuses.pending_review }} awaiting review and {{ dashboard.statuses.scheduled }} scheduled for the next edition.</p>
    <div class="mt-6 space-y-3">
        <a class="dropdown-item border border-line" href="{{ path('admin_article_index', {status: 'pending_review'}) }}"><twig:Icon name="check"/>Review the submission queue<twig:Icon name="arrow"/></a>
        <a class="dropdown-item border border-line" href="{{ path('admin_article_index', {status: 'scheduled'}) }}"><twig:Icon name="clock"/>See scheduled stories<twig:Icon name="arrow"/></a>
        <a class="dropdown-item border border-line" href="{{ path('admin_article_create') }}"><twig:Icon name="plus"/>Create an article</a>
    </div>
    {% if is_granted('analytics.view') %}<p class="mt-6 rounded-control bg-canvas p-4 text-xs leading-relaxed text-muted">Views come from daily rollups of de-duplicated visitor activity.{% if is_granted('newsletter.manage') %} Newsletter subscribers: {{ dashboard.subscribers|number_format }}.{% endif %}</p>{% endif %}
</section>
</div>
{% endif %}
{% endblock %}
