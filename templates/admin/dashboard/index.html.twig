{% extends 'admin/layout.html.twig' %}
{% block page_title %}Dashboard{% endblock %}
{% block actions %}<twig:Button variant="secondary" href="{{ path('admin_article_index', {status: 'draft'}) }}">Review drafts</twig:Button><twig:Button data-dialog-open="admin-quick-draft"><twig:Icon name="plus"/>Capture an idea</twig:Button>{% endblock %}
{% block content %}
{% if state == 'loading' %}<div class="card p-7" role="status"><p class="mb-5 text-sm text-muted">Loading your editorial overview…</p><twig:Skeleton lines="6"/></div>
{% elseif state == 'error' %}<twig:Alert tone="danger" title="Your overview could not be loaded">This is a simulated error. <a class="underline" href="{{ path('admin_dashboard_index') }}">Try again</a>.</twig:Alert>
{% elseif state == 'empty' %}<div class="card p-10"><twig:EmptyState title="Your first story starts here" description="There are no records in this simulated empty workspace. Capture an idea to explore the preview form."/><div class="mt-5 text-center"><twig:Button data-dialog-open="admin-quick-draft">Capture an idea</twig:Button></div></div>
{% else %}
<div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">{% for stat in dashboard.stats %}<twig:StatCard label="{{ stat.label }}" value="{{ stat.value }}" icon="{{ stat.icon }}" note="{{ stat.note }}"/>{% endfor %}</div>
<div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
    {% include 'admin/partials/chart.html.twig' with {id: 'views-chart', title: 'A growing conversation', subtitle: 'Article views · Nov 5–11, 2026 · illustrative', type: 'line', chart: dashboard.views, unit: 'views'} %}
    {% include 'admin/partials/chart.html.twig' with {id: 'categories-chart', title: 'What readers explore', subtitle: 'Category share · illustrative', type: 'doughnut', chart: dashboard.categories, unit: '%'} %}
</div>
<div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
<section class="card min-w-0 p-5 sm:p-6"><div class="mb-5 flex items-center justify-between gap-4"><h2 class="text-lg font-semibold">On the editorial desk</h2><a href="{{ path('admin_article_index') }}" class="text-xs font-semibold text-brand">All articles ↗</a></div><div class="space-y-1">{% for article in dashboard.recentArticles %}<div class="flex flex-wrap items-center gap-3 border-b border-line py-4 last:border-0"><img class="h-14 w-16 rounded-control object-cover" src="{{ asset(article.featuredImage.url) }}" alt="" width="64" height="56" loading="lazy"><div class="min-w-0 flex-1"><a class="block text-sm font-semibold hover:text-brand" href="{{ path('admin_article_index', {q: article.title}) }}">{{ article.title }}</a><p class="mt-1 text-xs text-muted">{{ article.author.displayName }} · Updated {{ article.updatedAt|date('M j') }}</p></div><twig:Badge tone="{{ article.status == 'scheduled' ? 'info' : 'neutral' }}">{{ article.status|replace({'_': ' '})|title }}</twig:Badge></div>{% endfor %}</div></section>
<section id="recent-comments" class="card scroll-mt-24 p-5 sm:p-6"><h2 class="text-lg font-semibold">Reader conversations</h2><p class="mt-2 text-xs text-muted">Moderation is not connected yet.</p><div class="mt-5 space-y-5">{% for comment in dashboard.comments %}<article class="border-b border-line pb-5 last:border-0"><div class="flex items-center justify-between gap-3"><p class="text-sm font-semibold">{{ comment.guestName }}</p><twig:Badge tone="{{ comment.status == 'pending' ? 'warning' : 'success' }}">{{ comment.status|title }}</twig:Badge></div><p class="mt-3 text-sm leading-relaxed text-muted">{{ comment.content }}</p><time class="mt-3 block text-xs text-muted" datetime="{{ comment.createdAt|date('c') }}">{{ comment.createdAt|date('M j, Y') }}</time></article>{% endfor %}</div></section>
</div>
<div class="mt-6 grid gap-6 xl:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]">
<section class="card p-5 sm:p-6"><h2 class="mb-5 text-lg font-semibold">Around the workspace</h2><ol class="space-y-5">{% for log in dashboard.activity %}<li class="flex gap-3"><span class="mt-1 rounded-full bg-brand/10 p-2 text-brand"><twig:Icon name="clock" size="16"/></span><div><p class="text-sm">{{ log.context.summary }}</p><p class="mt-1 text-xs text-muted">{{ log.user.displayName }} · <time datetime="{{ log.createdAt|date('c') }}">{{ log.createdAt|date('M j, H:i') }}</time></p></div></li>{% endfor %}</ol></section>
<section class="card p-5 sm:p-6"><h2 class="text-lg font-semibold">Make room for what’s next</h2><p class="mt-3 text-sm leading-relaxed text-muted">{{ dashboard.statuses.draft }} drafts in progress, {{ dashboard.statuses.pending_review }} story to review and {{ dashboard.statuses.scheduled }} scheduled for the next edition.</p><div class="mt-6 space-y-3"><a class="dropdown-item border border-line" href="{{ path('admin_article_index', {status: 'pending_review'}) }}"><twig:Icon name="check"/>Review the submission queue<twig:Icon name="arrow"/></a><a class="dropdown-item border border-line" href="{{ path('admin_article_index', {status: 'scheduled'}) }}"><twig:Icon name="clock"/>See scheduled stories<twig:Icon name="arrow"/></a><button class="dropdown-item border border-line" type="button" data-dialog-open="admin-quick-draft"><twig:Icon name="plus"/>Capture a draft outline</button></div><p class="mt-6 rounded-control bg-canvas p-4 text-xs leading-relaxed text-muted">Charts use an explicit mock snapshot, not live reader tracking. Email delivery and subscriber analytics follow in later milestones.</p></section>
</div>
{% endif %}
{% endblock %}
