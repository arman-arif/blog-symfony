{% extends 'admin/layout.html.twig' %}
{% block page_title %}Permission required{% endblock %}
{% block breadcrumb %}Permission preview{% endblock %}
{% block eyebrow %}Access state preview{% endblock %}
{% block heading %}This area needs a little more access.{% endblock %}
{% block intro %}Ask an administrator for the specific permission you need. This is a UI example, not an authenticated authorization decision.{% endblock %}
{% block content %}<div class="card max-w-3xl p-8"><twig:Icon name="shield" size="40"/><h2 class="mt-5 text-xl font-semibold">You do not have permission to continue.</h2><p class="mt-3 text-sm text-muted">Your work is still here. Return to the dashboard or check with the person who manages your editorial role.</p><twig:Button href="{{ path('admin_dashboard_index') }}" class="mt-6">Back to dashboard</twig:Button></div>{% endblock %}
