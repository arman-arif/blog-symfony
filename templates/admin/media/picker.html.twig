<twig:Modal id="media-picker" title="Choose from the media library" class="max-w-3xl" data-component="modal media-picker">
<p class="mb-5 text-sm text-muted">Original local illustrations. Selection changes the preview only; no upload or server update occurs.</p><label for="media-picker-query" class="field-label">Search media</label><input id="media-picker-query" class="field-control mb-5" type="search" placeholder="Search by title or alternative text" data-media-query>
<div class="grid grid-cols-2 gap-4 sm:grid-cols-3" data-media-grid>{% for item in media %}<button type="button" class="rounded-control border border-line p-2 text-left hover:border-brand" data-media-select data-media-id="{{ item.id }}" data-media-url="{{ asset(item.url) }}" data-media-alt="{{ item.alt }}" data-media-caption="{{ item.caption }}" data-media-name="{{ item.originalName }}" data-media-width="{{ item.width }}" data-media-height="{{ item.height }}" aria-pressed="false"><img src="{{ asset(item.url) }}" alt="{{ item.alt }}" width="{{ item.width }}" height="{{ item.height }}" loading="lazy" class="aspect-video w-full rounded-control object-cover"><span class="mt-2 block break-words text-xs font-semibold">{{ item.originalName }}</span></button>{% endfor %}</div>
<p class="text-sm text-muted" data-media-empty hidden>No matching media. Try another search.</p><p class="mt-4 text-xs text-muted" data-media-selection role="status">No image selected</p><div class="mt-5 flex flex-wrap justify-end gap-3"><twig:Button variant="secondary" data-dialog-close>Cancel</twig:Button><twig:Button data-media-insert disabled>Use selected image</twig:Button></div>
</twig:Modal>
