{% extends 'admin/layout.html.twig' %}
{% block page_title %}Media library{% endblock %}
{% block breadcrumb %}Media library{% endblock %}
{% block eyebrow %}Content / Media{% endblock %}
{% block heading %}Images and documents, in one place.{% endblock %}
{% block intro %}Uploads are validated, re-encoded to strip image metadata, and stored with randomized filenames.{% endblock %}
{% block actions %}<twig:Button href="#media-upload">Upload a file</twig:Button>{% endblock %}
{% block content %}
<section id="media-upload" class="card mb-6 p-5" aria-labelledby="upload-heading">
    <h2 id="upload-heading" class="font-display text-2xl">Upload</h2>
    <p class="mt-1 text-sm text-muted">JPEG, PNG, WebP, GIF, PDF, TXT, CSV or DOCX. SVG and executable formats are rejected.</p>
    {{ form_start(uploadForm, {attr: {class: 'mt-5', novalidate: 'novalidate', 'data-component': 'validate'}}) }}
    {{ form_errors(uploadForm) }}
    <div class="grid gap-4 md:grid-cols-3">{{ form_row(uploadForm.file) }}{{ form_row(uploadForm.alt) }}{{ form_row(uploadForm.caption) }}</div>
    <twig:Button type="submit">Upload file</twig:Button>
    {{ form_end(uploadForm) }}
</section>
<form method="get" action="{{ path('admin_media_index') }}" class="card mb-6 grid gap-4 p-4 md:grid-cols-4" role="search">
    <div><label class="field-label" for="media-query">Search</label><input class="field-control" id="media-query" type="search" name="q" value="{{ filters.q }}" placeholder="Name, alt or caption"></div>
    <div><label class="field-label" for="media-type">Type</label><select class="field-control" id="media-type" name="type"><option value="">All types</option><option value="image" {% if filters.type == 'image' %}selected{% endif %}>Images</option><option value="document" {% if filters.type == 'document' %}selected{% endif %}>Documents</option></select></div>
    <div><label class="field-label" for="media-date">Uploaded on</label><input class="field-control" id="media-date" type="date" name="date" value="{{ filters.date }}"></div>
    <div class="flex items-end gap-2"><twig:Button type="submit" variant="secondary">Filter</twig:Button><a class="btn btn-ghost" href="{{ path('admin_media_index') }}">Reset</a></div>
</form>
{% if mediaItems is empty %}
    <p class="card p-10 text-center text-sm text-muted">No media matches these filters. Upload a file to get started.</p>
{% else %}
<div class="grid grid-cols-2 gap-4 md:grid-cols-3 xl:grid-cols-4">
    {% for media in mediaItems %}
        <article class="card overflow-hidden" data-media-item data-type="{{ media.mimeType starts with 'image/' ? 'image' : 'document' }}">
            {% if media.mimeType starts with 'image/' %}
                <a href="{{ path('admin_media_edit', {id: media.id}) }}"><img class="aspect-video w-full object-cover" src="{{ media_url(media, 'thumbnail') }}" alt="{{ media.alt ?: media.originalName }}" width="320" height="180" loading="lazy"></a>
            {% else %}
                <div class="flex aspect-video items-center justify-center bg-canvas text-xs font-semibold uppercase tracking-wide text-muted">{{ media.mimeType == 'application/pdf' ? 'PDF document' : 'Document' }}</div>
            {% endif %}
            <div class="p-4">
                <h2 class="truncate text-sm font-semibold">{{ media.originalName }}</h2>
                <p class="mt-1 text-xs text-muted">{{ (media.size / 1024)|round }} KB · {{ media.createdAt|date('M j, Y') }}</p>
                <div class="mt-3 flex flex-wrap gap-1">
                    <twig:Button href="{{ path('admin_media_edit', {id: media.id}) }}" variant="secondary" size="sm">Edit</twig:Button>
                    <form method="post" action="{{ path('admin_media_delete', {id: media.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('media_delete') }}"><twig:Button type="submit" variant="danger" size="sm">Delete</twig:Button></form>
                </div>
            </div>
        </article>
    {% endfor %}
</div>
{% set pages = ((total - 1) // 24) + 1 %}
{% if total > 24 %}
<nav class="mt-6 flex items-center justify-between text-sm" aria-label="Media pagination">
    <span class="text-muted">{{ total }} files · page {{ page }} of {{ pages }}</span>
    <div class="flex gap-2">
        {% if page > 1 %}<a class="btn btn-secondary btn-sm" href="{{ path('admin_media_index', app.request.query.all|merge({page: page - 1})) }}">Previous</a>{% endif %}
        {% if page < pages %}<a class="btn btn-secondary btn-sm" href="{{ path('admin_media_index', app.request.query.all|merge({page: page + 1})) }}">Next</a>{% endif %}
    </div>
</nav>
{% endif %}
{% endif %}
{% endblock %}
