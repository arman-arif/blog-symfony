{% extends 'admin/layout.html.twig' %}
{% block page_title %}{{ record.id ? 'Edit menu' : 'New menu' }}{% endblock %}
{% block breadcrumb %}Navigation menus / {{ record.id ? 'Edit' : 'New' }}{% endblock %}
{% block eyebrow %}Content / Navigation{% endblock %}
{% block heading %}Give readers a thoughtful next step.{% endblock %}
{% block intro %}Drag links onto another link’s nested area, or use Up, Down, Nest and Unnest. Entire branches move together. The public navigation is not changed.{% endblock %}
{% block actions %}<twig:Button variant="secondary" href="{{ path('admin_menu_index') }}">All menus</twig:Button>{% endblock %}
{% block content %}<twig:PreviewStates state="{{ state }}"><twig:PreviewForm data-component="validate content-form menu-builder" successMessage="Menu validated locally. Its structure was not saved."><twig:AdminFormLayout sidebarTitle="Menu location"><div class="space-y-6"><twig:Field id="menu-name" label="Menu name" required><twig:Input id="menu-name" name="name" value="{{ record.name }}" required minlength="3" maxlength="100"/></twig:Field><div class="rounded-control bg-canvas p-5"><h2 class="mb-3 font-semibold">Add a link</h2><p class="mb-4 text-xs text-muted">Choose a suggested destination or enter a relative path / absolute HTTP(S) URL.</p><label for="menu-link-label" class="field-label">Link label</label><input id="menu-link-label" class="field-control mb-3" data-add-menu-label maxlength="80"><label for="menu-link-type" class="field-label">Type</label><select id="menu-link-type" class="field-control mb-3" data-add-menu-type><option value="custom">Custom URL</option><option value="page">Internal page</option><option value="category">Category</option><option value="article">Article</option></select><label for="menu-link-target" class="field-label">Destination</label><input id="menu-link-target" class="field-control mb-3" data-add-menu-target list="menu-destinations" placeholder="/about"><datalist id="menu-destinations">{% for page in pages %}<option value="{{ path('front_page', {slug: page.slug}) }}">{{ page.title }}</option>{% endfor %}{% for category in categories %}<option value="{{ path('front_category', {slug: category.slug}) }}">{{ category.name }}</option>{% endfor %}</datalist><twig:Button variant="secondary" data-add-menu-item>Add local link</twig:Button></div><p class="text-xs text-muted" role="status" aria-live="polite" data-menu-status>Drag and keyboard controls become available with JavaScript.</p><ol data-menu-list data-menu-root aria-label="Menu links" class="min-h-16 rounded-control border-2 border-dashed border-line bg-canvas p-3">{% for item in record.items|filter(item => not item.parent) %}{% include 'admin/menu/item.html.twig' %}{% endfor %}</ol><textarea data-menu-output name="items" hidden readonly></textarea></div><twig:block name="sidebar"><div class="space-y-6"><twig:Field id="menu-location" label="Location"><twig:Select id="menu-location" name="location" value="{{ record.location }}" options="{{ {header: 'Header', footer: 'Footer', sidebar: 'Sidebar'} }}"/></twig:Field><twig:Button type="submit">Validate menu</twig:Button><p class="text-xs text-muted">Maximum three preview levels. Menu-location uniqueness and link permissions are backend checks.</p></div></twig:block></twig:AdminFormLayout><template data-menu-template>{% include 'admin/menu/item.html.twig' with {item: {id: 'new', label: '', type: 'custom', target: ''}, record: {items: []}} %}</template></twig:PreviewForm></twig:PreviewStates>{% endblock %}
