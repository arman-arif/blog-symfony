{% extends 'admin/layout.html.twig' %}
{% block page_title %}{{ menu.id ? 'Edit menu' : 'New menu' }}{% endblock %}
{% block breadcrumb %}Menus / {{ menu.id ? menu.name : 'New' }}{% endblock %}
{% block eyebrow %}Site / Navigation{% endblock %}
{% block heading %}Shape the paths through the journal.{% endblock %}
{% block intro %}Add nested items with a parent, then drag to reorder. Changes appear on the public site after saving.{% endblock %}
{% block actions %}<twig:Button variant="secondary" href="{{ path('admin_menu_index') }}">All menus</twig:Button>{% endblock %}
{% block content %}
<div class="grid gap-6 xl:grid-cols-[minmax(0,1fr)_22rem]">
<section class="card p-5 sm:p-7">
    <h2 class="text-xl font-semibold">Menu details</h2>
    {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
    {{ form_errors(form) }}
    <div class="mt-5 grid gap-5 sm:grid-cols-2">{{ form_row(form.name) }}{{ form_row(form.location) }}</div>
    <div class="mt-5"><twig:Button type="submit">Save menu</twig:Button></div>
    {{ form_end(form) }}
</section>
{% if menu.id %}
<section class="card p-5 sm:p-7" data-menu-sortable data-reorder-url="{{ path('admin_menu_reorder', {id: menu.id}) }}" data-csrf-token="{{ csrf_token('menu_reorder') }}">
    <div class="flex items-center justify-between gap-3"><h2 class="text-xl font-semibold">Menu items</h2><p class="text-xs text-muted" data-menu-status>Drag to reorder</p></div>
    {% macro items(menu, parent, depth) %}
        <ol class="{{ depth > 0 ? 'ml-6 mt-2 border-l border-line pl-4' : 'mt-5' }} space-y-2">
        {% for item in menu.items|filter(i => i.parent == parent)|sort((a, b) => a.position <=> b.position) %}
            <li class="rounded-control border border-line bg-surface px-3 py-2" draggable="true" data-menu-item data-id="{{ item.id }}" data-parent-id="{{ item.parent ? item.parent.id : '' }}">
                <div class="flex flex-wrap items-center gap-2">
                    <span class="cursor-grab text-muted" aria-hidden="true">⠿</span>
                    <span class="text-sm font-semibold">{{ item.label }}</span>
                    <span class="badge badge-neutral">{{ item.type.value }}</span>
                    <span class="text-xs text-muted">{{ item.target }}</span>
                    <div class="ml-auto flex items-center gap-1">
                        <a class="btn btn-ghost btn-sm" href="{{ path('admin_menu_item_edit', {itemId: item.id}) }}">Edit</a>
                        <form method="post" action="{{ path('admin_menu_item_delete', {itemId: item.id}) }}"><input type="hidden" name="_token" value="{{ csrf_token('menu_item_delete') }}"><button type="submit" class="btn btn-ghost btn-sm text-danger">Remove</button></form>
                    </div>
                </div>
                {% if item.children is not empty %}{{ _self.items(menu, item, depth + 1) }}{% endif %}
            </li>
        {% endfor %}
        </ol>
    {% endmacro %}
    {{ _self.items(menu, null, 0) }}
    <p class="mt-4 text-xs text-muted">Nesting is changed on the item's edit screen. Drag reorders siblings.</p>
</section>
<section class="card h-fit p-5 sm:p-7">
    <h2 class="text-xl font-semibold">Add an item</h2>
    {{ form_start(itemForm, {action: path('admin_menu_item_create', {id: menu.id}), attr: {novalidate: 'novalidate'}}) }}
    <div class="mt-5 space-y-4">{{ form_row(itemForm.label) }}{{ form_row(itemForm.type) }}{{ form_row(itemForm.target) }}{{ form_row(itemForm.parent) }}{{ form_row(itemForm.position) }}</div>
    <twig:Button type="submit" class="mt-5">Add item</twig:Button>
    {{ form_end(itemForm) }}
</section>
{% else %}
<section class="card p-6"><twig:Alert tone="info" title="Save the menu first">Add items after creating the menu.</twig:Alert></section>
{% endif %}
</div>
{% endblock %}
