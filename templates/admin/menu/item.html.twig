<li data-menu-item data-id="{{ item.id }}" draggable="true" class="my-3 min-w-0 rounded-control border border-line bg-surface p-3">
<div class="flex flex-wrap items-center justify-between gap-2"><span class="text-xs font-semibold text-muted" data-menu-item-caption>{{ item.label }}</span><div class="flex flex-wrap gap-1" role="group" aria-label="Reorder {{ item.label }}">{% for action, label in {up: 'Up', down: 'Down', indent: 'Nest', outdent: 'Unnest'} %}<button type="button" class="btn btn-ghost btn-sm" data-menu-move="{{ action }}">{{ label }}</button>{% endfor %}<button type="button" class="btn btn-ghost btn-sm" data-menu-remove data-component="confirm" data-confirm-message="Remove this item and its nested links from the local menu preview? Nothing is saved.">Remove</button></div></div>
<div class="mt-3 grid gap-3 md:grid-cols-3"><label class="block text-xs font-semibold">Label<input class="field-control mt-2" data-menu-label value="{{ item.label }}" required maxlength="80"></label><label class="block text-xs font-semibold">Link type<select class="field-control mt-2" data-menu-type>{% for type, label in {custom: 'Custom URL', page: 'Internal page', category: 'Category', article: 'Article'} %}<option value="{{ type }}" {% if item.type == type %}selected{% endif %}>{{ label }}</option>{% endfor %}</select></label><label class="block text-xs font-semibold">Destination<input class="field-control mt-2" data-menu-target value="{{ item.target }}" required placeholder="/about or https://…"></label></div><ol data-menu-list aria-label="Nested links under {{ item.label }}" class="ml-3 min-h-4 border-l border-line pl-3">{% for child in record.items|filter(child => child.parent and child.parent.id == item.id) %}{% include 'admin/menu/item.html.twig' with {item: child} %}{% endfor %}</ol>
</li>
