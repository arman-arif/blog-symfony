{% extends 'admin/layout.html.twig' %}
{% block page_title %}Edit menu item{% endblock %}
{% block breadcrumb %}Menus / {{ item.menu.name }} / {{ item.label }}{% endblock %}
{% block eyebrow %}Site / Navigation{% endblock %}
{% block heading %}Refine this destination.{% endblock %}
{% block actions %}<twig:Button variant="secondary" href="{{ path('admin_menu_edit', {id: item.menu.id}) }}">Back to menu</twig:Button>{% endblock %}
{% block content %}
<div class="card max-w-2xl p-6">
{{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}
{{ form_errors(form) }}
<div class="space-y-5">{{ form_row(form.label) }}{{ form_row(form.type) }}{{ form_row(form.target) }}{{ form_row(form.parent) }}{{ form_row(form.position) }}</div>
<div class="mt-6"><twig:Button type="submit">Save item</twig:Button></div>
{{ form_end(form) }}
</div>
{% endblock %}
