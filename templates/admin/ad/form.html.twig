{% extends 'admin/layout.html.twig' %}
{% block page_title %}{{ ad.id ? 'Edit advertisement' : 'New advertisement' }}{% endblock %}
{% block breadcrumb %}Advertisements / {{ ad.id ? 'Edit' : 'New' }}{% endblock %}
{% block eyebrow %}Content / Partnerships{% endblock %}
{% block heading %}{{ ad.id ? 'Refine this placement.' : 'A place for the right partnership.' }}{% endblock %}
{% block intro %}Image banners use the selected media and destination. HTML and AdSense creatives are rendered as trusted admin content.{% endblock %}
{% block actions %}<twig:Button variant="secondary" href="{{ path('admin_ad_index') }}">All advertisements</twig:Button>{% endblock %}
{% block content %}
{{ form_start(form, {attr: {novalidate: 'novalidate', 'data-component': 'validate'}}) }}
{{ form_errors(form) }}
<twig:AdminFormLayout sidebarTitle="Placement & schedule">
    <div class="space-y-6">
        {{ form_row(form.name) }}
        {{ form_row(form.type) }}
        {{ form_row(form.content) }}
        <p class="text-xs text-muted">HTML/AdSense code is rendered only on the public site for visitors. Keep it limited to trusted advertising partners.</p>
        {{ form_row(form.image) }}
        {{ form_row(form.targetUrl) }}
    </div>
    <twig:block name="sidebar">
        <div class="space-y-6">
            {{ form_row(form.placement) }}
            {{ form_row(form.afterParagraph) }}
            {{ form_row(form.startsAt) }}
            {{ form_row(form.endsAt) }}
            {{ form_row(form.priority) }}
            {{ form_row(form.isActive) }}
            <twig:Button type="submit" class="w-full">Save advertisement</twig:Button>
        </div>
    </twig:block>
</twig:AdminFormLayout>
{{ form_end(form) }}
{% endblock %}
