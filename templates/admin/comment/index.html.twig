{% extends 'admin/layout.html.twig' %}
{% block page_title %}Comment moderation{% endblock %}
{% block breadcrumb %}Comments{% endblock %}
{% block eyebrow %}Content / Reader conversations{% endblock %}
{% block heading %}Make room for a good conversation.{% endblock %}
{% block intro %}Review reader responses, try moderation decisions and compose a reply. These actions affect only the local preview; nobody is notified.{% endblock %}
{% block content %}<div data-component="moderation">{% set tabs = [] %}{% for key, label in {all: 'All', pending: 'Pending', approved: 'Approved', rejected: 'Rejected', spam: 'Spam'} %}{% set tabs = tabs|merge([{key: key, label: label, href: path('admin_comment_index', {tab: key})}]) %}{% endfor %}
<twig:DataTable id="comments-table" caption="Comments" columns="{{ [{key: 'name', label: 'Reader', sortable: true}, {key: 'content', label: 'Comment'}, {key: 'article', label: 'Article'}, {key: 'status', label: 'Status', sortable: true}] }}" tabs="{{ tabs }}" state="{{ state }}">{% for comment in records %}<tr data-row data-id="{{ comment.id }}" data-name="{{ comment.guestName }}" data-status="{{ comment.status }}" data-search="{{ comment.guestName }} {{ comment.content }} {{ comment.article.title }}"><td><input type="checkbox" data-select-row disabled aria-label="Select comment by {{ comment.guestName }}"></td><td><p class="font-semibold">{{ comment.guestName }}</p><p class="mt-1 text-xs text-muted">{{ comment.guestEmail }}</p><p class="mt-1 text-xs text-muted">{{ comment.createdAt|date('M j, Y') }}</p></td><td class="min-w-64 max-w-sm"><p>{{ comment.content }}</p>{% if comment.parent %}<p class="mt-2 text-xs text-muted">Reply to comment #{{ comment.parent.id }}</p>{% endif %}{% if comment.reportCount %}<p class="reader-report">{{ comment.reportCount }} reader report</p>{% endif %}<div data-local-replies></div></td><td><a class="text-brand underline" href="{{ path('admin_article_preview', {id: comment.article.id}) }}">{{ comment.article.title }}</a></td><td><span data-moderation-status class="badge {{ comment.status == 'approved' ? 'badge-success' : (comment.status == 'pending' ? 'badge-warning' : 'badge-neutral') }}">{{ comment.status|title }}</span></td><td><div class="flex flex-wrap gap-1 min-w-48">{% for value, label in {approved: 'Approve', rejected: 'Reject', spam: 'Spam'} %}<button type="button" class="btn btn-ghost btn-sm" data-moderate="{{ value }}" disabled>{{ label }}</button>{% endfor %}<button type="button" class="btn btn-ghost btn-sm" data-comment-reply data-dialog-open="comment-reply-dialog" disabled>Reply</button><twig:Button variant="ghost" size="sm" data-component="confirm" data-row-remove data-confirm-message="Remove this comment from the local moderation preview? No server record is deleted.">Remove</twig:Button></div></td></tr>{% endfor %}</twig:DataTable></div>
<twig:Modal id="comment-reply-dialog" title="Reply to a reader"><p class="mb-5 text-sm text-muted" data-reply-context></p><twig:PreviewForm id="moderation-reply-form" successMessage="Reply added locally. Nothing was sent or stored."><twig:Field id="moderation-reply" label="Your reply" required><twig:Textarea id="moderation-reply" name="content" required minlength="10" maxlength="2000" rows="5"/></twig:Field><twig:Button type="submit">Add local reply</twig:Button></twig:PreviewForm></twig:Modal>{% endblock %}
