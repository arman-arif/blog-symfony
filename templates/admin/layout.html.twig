{% extends 'base.html.twig' %}
{% block title %}{% block page_title %}Editorial workspace{% endblock %} · Fieldnotes CMS{% endblock %}
{% block importmap %}{{ importmap('admin') }}{% endblock %}
{% block body %}
<div class="admin-shell" data-component="admin-shell">
    <aside id="admin-sidebar" class="admin-sidebar" aria-label="Editorial workspace navigation">
        <div class="flex h-20 items-center justify-between border-b border-line px-5"><a class="admin-brand font-display text-3xl" href="{{ path('admin_dashboard_index') }}" aria-label="Fieldnotes dashboard">fieldnotes<span class="text-accent">.</span></a><button type="button" class="btn btn-ghost w-11 px-0" data-sidebar-collapse aria-expanded="true" aria-controls="admin-sidebar" aria-label="Collapse sidebar"><twig:Icon name="menu"/></button></div>
        {% include 'admin/partials/navigation.html.twig' with {mobile: false} %}
        <div class="admin-sidebar-note m-4 rounded-control bg-brand/5 p-4 text-xs leading-relaxed text-muted"><strong class="block text-brand">Made for thoughtful publishing.</strong>Mock workspace. No changes are persisted.</div>
    </aside>
    <div class="admin-workspace min-w-0">
        <header class="sticky top-0 z-20 flex min-h-20 flex-wrap items-center justify-between gap-3 border-b border-line bg-surface/95 px-4 py-3 backdrop-blur sm:px-7">
            <div class="flex min-w-0 items-center gap-2"><twig:Button variant="ghost" size="icon" data-dialog-open="admin-mobile-navigation" class="lg:hidden" aria-label="Open admin navigation"><twig:Icon name="menu"/></twig:Button><form action="{{ path('admin_article_index') }}" method="get" role="search" class="hidden sm:block"><label for="admin-search" class="sr-only">Search workspace articles</label><div class="flex items-center gap-2"><twig:Icon name="search"/><input id="admin-search" class="max-w-48 border-0 bg-transparent p-2 text-sm focus:ring-0" type="search" name="q" placeholder="Search the workspace…"></div></form><span class="text-sm font-semibold sm:hidden">Fieldnotes CMS</span></div>
            <div class="flex items-center gap-1 sm:gap-3">
                <twig:Button variant="ghost" size="icon" data-component="theme" aria-pressed="false" aria-label="Toggle dark mode"><twig:Icon name="sun"/></twig:Button>
                <twig:Dropdown id="admin-notifications" label="Updates"><p class="px-3 py-2 text-xs font-semibold text-muted">Editorial reminders · mock</p><a class="dropdown-item" href="{{ path('admin_article_index', {status: 'pending_review'}) }}">1 story awaits review</a><a class="dropdown-item" href="{{ path('admin_dashboard_index') }}#recent-comments">1 comment awaits moderation</a><a class="dropdown-item" href="{{ path('admin_article_index', {status: 'scheduled'}) }}">2 stories are scheduled</a></twig:Dropdown>
                <div class="hidden md:block"><twig:Dropdown id="admin-quick-create" label="Quick create"><a class="dropdown-item" href="{{ path('admin_article_create') }}"><twig:Icon name="plus"/>New article</a><button class="dropdown-item" type="button" data-dialog-open="admin-quick-draft">Draft outline</button><a class="dropdown-item" href="{{ path('admin_media_index') }}">Media library / upload preview</a></twig:Dropdown></div>
                <twig:Dropdown id="admin-profile-menu" label="Maya"><button type="button" class="dropdown-item" data-dialog-open="admin-profile-preview"><twig:Icon name="user"/>Profile summary</button><a class="dropdown-item" href="{{ path('front_home') }}">Visit public website<twig:Icon name="arrow"/></a><button type="button" class="dropdown-item" disabled title="Authentication arrives in M4">Sign out · unavailable in preview</button></twig:Dropdown>
            </div>
        </header>
        <main id="main-content" class="min-w-0 p-4 sm:p-7 xl:p-9">
            <div class="mb-6 flex flex-wrap items-center justify-between gap-3 border-b border-line pb-4 text-xs text-muted" role="status"><span><strong class="text-brand">UI preview</strong> · Fictional records. Forms never save, publish, upload or send data.</span><a href="{{ path('front_home') }}" class="font-semibold text-brand">View site ↗</a></div>
            <nav aria-label="Breadcrumb" class="mb-4 text-xs text-muted"><a href="{{ path('admin_dashboard_index') }}" class="hover:text-brand">Workspace</a><span aria-hidden="true" class="mx-2">/</span><span aria-current="page">{% block breadcrumb %}Dashboard{% endblock %}</span></nav>
            <div class="mb-7 flex flex-wrap items-start justify-between gap-4"><div class="min-w-0"><p class="eyebrow mb-2">{% block eyebrow %}Your editorial overview{% endblock %}</p><h1 class="font-display text-4xl tracking-tight sm:text-5xl">{% block heading %}A good day to make something.{% endblock %}</h1><p class="mt-3 max-w-2xl text-sm leading-relaxed text-muted">{% block intro %}A little perspective on your stories, readers and the people behind them.{% endblock %}</p></div><div class="flex flex-wrap gap-2">{% block actions %}{% endblock %}</div></div>
            {% block content %}{% endblock %}
        </main>
        <footer class="flex flex-wrap justify-between gap-3 border-t border-line px-7 py-5 text-xs text-muted"><span>Fieldnotes · Editorial workspace</span><span>UI-only preview / Symfony &amp; locally hosted assets</span></footer>
    </div>
</div>
<twig:Modal id="admin-mobile-navigation" title="Editorial workspace" drawer><a class="mb-5 block font-display text-3xl" href="{{ path('admin_dashboard_index') }}">fieldnotes.</a>{% include 'admin/partials/navigation.html.twig' with {mobile: true} %}</twig:Modal>
<twig:Modal id="admin-quick-draft" title="Capture a draft outline"><p class="mb-5 text-sm text-muted">Try the shared form layout. Nothing is created or saved. Use New article for the complete local editor.</p><twig:PreviewForm successMessage="Draft outline validated locally. No article was created."><twig:Field id="quick-draft-title" label="Working title" help="Give your idea a clear starting point."><twig:Input id="quick-draft-title" name="title" required minlength="5"/></twig:Field><twig:Field id="quick-draft-notes" label="Notes"><twig:Textarea id="quick-draft-notes" name="notes" rows="3"/></twig:Field><twig:Button type="submit">Validate outline</twig:Button></twig:PreviewForm></twig:Modal>
<twig:Modal id="admin-profile-preview" title="Your editorial profile"><div class="flex items-center gap-4"><twig:Avatar name="{{ currentUser.displayName }}"/><div><p class="font-semibold">{{ currentUser.displayName }}</p><p class="text-sm text-muted">{{ currentUser.jobTitle }}</p></div></div><p class="mt-5 text-sm text-muted">{{ currentUser.bio }}</p><p class="mt-5 text-xs text-muted">This fictional profile cannot be changed yet. Profile management UI follows in M1.7b.</p></twig:Modal>
{% endblock %}
