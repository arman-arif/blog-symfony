{% extends 'admin/layout.html.twig' %}
{% block page_title %}{{ article.id ? 'Edit article' : 'Create article' }}{% endblock %}
{% block breadcrumb %}Articles / {{ article.id ? 'Edit' : 'New draft' }}{% endblock %}
{% block eyebrow %}Content / {{ article.id ? 'Edit story' : 'New story' }}{% endblock %}
{% block heading %}{{ article.id ? 'Give this story room to grow.' : 'Begin with a little curiosity.' }}{% endblock %}
{% block intro %}A complete local editing preview. Reloading discards your changes; no story can be saved or published yet.{% endblock %}
{% block actions %}<twig:Button variant="secondary" href="{{ path('admin_article_index') }}">All articles</twig:Button>{% if article.id %}<twig:Button variant="secondary" href="{{ path('admin_article_revisions', {id: article.id}) }}">Revisions</twig:Button>{% endif %}{% endblock %}
{% block content %}
<twig:PreviewStates state="{{ state }}">
<twig:PreviewForm id="article-form" data-component="validate article-form" data-new-article="{{ article.id ? 'false' : 'true' }}" successMessage="Article validated locally. Nothing was saved, scheduled or published.">
    <div class="mb-5 flex flex-wrap items-center justify-between gap-3"><p class="text-xs text-muted" role="status" aria-live="polite" data-autosave-status>Local preview ready · not persisted</p><div class="flex gap-2"><twig:Button variant="secondary" data-live-preview>Preview local changes</twig:Button><twig:Button type="submit">Validate draft</twig:Button></div></div>
    <twig:AdminFormLayout sidebarTitle="Story settings">
        <div class="space-y-6"><twig:Field id="article-title" label="Title" required help="A clear title helps readers find their way in."><twig:Input id="article-title" name="title" value="{{ article.title }}" required minlength="5" maxlength="180"/></twig:Field>
        <twig:Field id="article-slug" label="URL slug" required help="Preview URL only. Slug uniqueness will be checked by the backend."><div class="flex flex-wrap gap-2"><twig:Input id="article-slug" name="slug" value="{{ article.slug }}" required pattern="[a-z0-9]+(-[a-z0-9]+)*" class="min-w-0 flex-1"/><twig:Button variant="secondary" size="sm" data-regenerate-slug>Regenerate</twig:Button></div></twig:Field>
        <twig:Field id="article-subtitle" label="Subtitle"><twig:Input id="article-subtitle" name="subtitle" value="{{ article.subtitle }}" maxlength="240"/></twig:Field>
        <twig:Field id="article-excerpt" label="Excerpt" help="A short invitation to read; maximum 400 characters."><twig:Textarea id="article-excerpt" name="excerpt" value="{{ article.excerpt }}" maxlength="400" rows="3"/></twig:Field>
        <twig:RichEditor article="{{ article }}"/>
        <section class="rounded-control border border-line p-5" aria-labelledby="seo-panel-title"><h2 id="seo-panel-title" class="mb-5 text-lg font-semibold">Search &amp; sharing</h2><div class="space-y-5">
            <twig:Field id="article-seo-title" label="SEO title" help="Leave blank to use the article title."><twig:Input id="article-seo-title" name="seoTitle" value="{{ article.seo.title }}" maxlength="70"/></twig:Field><p class="text-xs text-muted" data-seo-title-count>0 / 70 characters</p>
            <twig:Field id="article-seo-description" label="Meta description"><twig:Textarea id="article-seo-description" name="seoDescription" value="{{ article.seo.description }}" maxlength="160" rows="3"/></twig:Field><p class="text-xs text-muted" data-seo-description-count>0 / 160 characters</p>
            <div class="grid gap-5 md:grid-cols-2"><twig:Field id="article-focus-keyword" label="Focus keyword"><twig:Input id="article-focus-keyword" name="focusKeyword" value="{{ article.seo.focusKeyword }}"/></twig:Field><twig:Field id="article-canonical" label="Canonical URL" help="Optional absolute HTTP(S) URL."><twig:Input id="article-canonical" name="canonicalUrl" type="url" value="{{ article.seo.canonicalUrl }}" placeholder="https://example.com/story"/></twig:Field></div>
            <twig:Choice id="article-noindex" name="noindex" label="Ask search engines not to index this story" checked="{{ article.seo.noindex }}"/>
            <div><p class="field-label">Open Graph image</p><div class="flex flex-wrap items-center gap-3"><img data-og-image hidden class="h-16 w-24 rounded-control object-cover" alt="Selected Open Graph image" width="96" height="64"><twig:Button variant="secondary" size="sm" data-dialog-open="media-picker" data-media-target="og">Choose sharing image</twig:Button><span class="text-xs text-muted" data-og-label>Uses featured image by default</span></div></div>
            <div class="rounded-control bg-canvas p-4" role="region" aria-label="Search result preview"><p class="mb-2 text-[10px] uppercase tracking-wider text-muted">Search snippet preview · not submitted</p><p class="break-all text-xs text-muted" data-snippet-url>fieldnotes.example/blog/{{ article.slug }}</p><p class="mt-2 text-lg font-medium text-brand" data-snippet-title>{{ article.title ?: 'Your article title' }}</p><p class="mt-2 text-sm text-muted" data-snippet-description>{{ article.excerpt ?: 'A short description of your story will appear here.' }}</p></div>
        </div></section></div>
        <twig:block name="sidebar"><div class="space-y-6">
            <twig:Field id="article-status" label="Status"><twig:Select id="article-status" name="status" value="{{ article.status }}" options="{{ {draft: 'Draft', pending_review: 'Pending review', scheduled: 'Scheduled', published: 'Published', unpublished: 'Unpublished'} }}"/></twig:Field>
            <twig:Field id="article-visibility" label="Visibility"><twig:Select id="article-visibility" name="visibility" value="{{ article.visibility }}" options="{{ {public: 'Public', private: 'Private'} }}"/></twig:Field>
            <div data-schedule-panel {% if article.status != 'scheduled' %}hidden{% endif %}><twig:Field id="article-scheduled-at" label="Schedule date & time" help="UTC preview. No publishing worker runs yet."><twig:Input id="article-scheduled-at" name="scheduledAt" type="datetime-local" value="{{ article.scheduledAt ? article.scheduledAt|date('Y-m-d\\TH:i') : '' }}"/></twig:Field></div>
            <twig:Field id="article-author" label="Author"><select id="article-author" name="author" class="field-control">{% for author in authors %}<option value="{{ author.id }}" {% if author.id == article.author.id %}selected{% endif %}>{{ author.displayName }}</option>{% endfor %}</select></twig:Field>
            <fieldset><legend class="field-label">Categories</legend>{% for category in categories|filter(item => not item.parent) %}<div><twig:Choice id="article-category-{{ category.id }}" name="categories[]" value="{{ category.id }}" label="{{ category.name }}" checked="{{ category.id in article.categories|map(item => item.id) }}"/>{% for child in categories|filter(item => item.parent and item.parent.id == category.id) %}<div class="ml-5 border-l border-line pl-3"><twig:Choice id="article-category-{{ child.id }}" name="categories[]" value="{{ child.id }}" label="{{ child.name }}" checked="{{ child.id in article.categories|map(item => item.id) }}"/></div>{% endfor %}</div>{% endfor %}</fieldset>
            <div><label class="field-label" for="article-tags-input">Tags</label><div class="flex gap-2"><input id="article-tags-input" class="field-control min-w-0" list="article-tags-options" placeholder="Add a topic" maxlength="50" data-tags-input><twig:Button variant="secondary" size="sm" data-add-tag aria-label="Add tag">+</twig:Button></div><datalist id="article-tags-options">{% for tag in tags %}<option value="{{ tag.name }}"></option>{% endfor %}</datalist><div class="mt-3 flex flex-wrap gap-2" data-tags-list>{% for tag in article.tags %}<span class="badge badge-neutral" data-tag="{{ tag.name }}">{{ tag.name }}<input type="hidden" name="tags[]" value="{{ tag.name }}"><button type="button" data-remove-tag aria-label="Remove {{ tag.name }}">×</button></span>{% endfor %}</div><p class="field-help">Suggestions are mock topics. Tags only change locally.</p></div>
            <div><p class="field-label">Featured image</p><img data-featured-image {% if not article.featuredImage %}hidden{% endif %} src="{{ article.featuredImage ? asset(article.featuredImage.url) : asset('images/cover-1.svg') }}" class="mb-3 aspect-video w-full rounded-control object-cover" alt="{{ article.featuredImage ? article.featuredImage.alt : '' }}" width="1200" height="800"><p class="mb-3 text-xs text-muted" data-featured-caption>{{ article.featuredImage ? article.featuredImage.caption : 'No image selected' }}</p><div class="flex flex-wrap gap-2"><twig:Button variant="secondary" size="sm" data-dialog-open="media-picker" data-media-target="featured">Choose image</twig:Button><twig:Button variant="ghost" size="sm" data-remove-featured>Remove</twig:Button></div><input type="hidden" name="featuredImage" data-featured-id value="{{ article.featuredImage ? article.featuredImage.id : '' }}"></div>
            <twig:Choice id="article-allow-comments" name="allowComments" type="toggle" label="Allow comments" checked="{{ article.allowComments }}"/>
            <p class="rounded-control bg-canvas p-4 text-xs leading-relaxed text-muted">Status, author and visibility changes are visual only. Backend authorization and publishing are not active.</p>
        </div></twig:block>
    </twig:AdminFormLayout>
</twig:PreviewForm>
{% include 'admin/media/picker.html.twig' %}
{% include 'admin/article/editor_dialogs.html.twig' %}
<twig:Modal id="article-live-preview" title="Local article preview" class="max-w-4xl"><p class="mb-5 text-xs text-muted">Unsaved browser content. This is not a public URL.</p><h2 class="font-display text-3xl" data-live-title></h2><p class="mt-3 text-lg text-muted" data-live-subtitle></p><img data-live-image hidden alt="" width="1200" height="800" class="mt-6 aspect-video w-full rounded-card object-cover"><div class="prose prose-stone mt-6 max-w-none dark:prose-invert" data-live-content></div></twig:Modal>
</twig:PreviewStates>{% endblock %}
