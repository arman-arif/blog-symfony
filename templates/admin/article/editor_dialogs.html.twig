<twig:Modal id="editor-link-dialog" title="Insert a link"><p class="mb-5 text-sm text-muted">HTTP(S) links only. No destination is fetched by this preview.</p><twig:PreviewForm id="editor-link-form" successMessage="Link added to the local editor."><twig:Field id="editor-link-text" label="Link text"><twig:Input id="editor-link-text" name="text" required/></twig:Field><twig:Field id="editor-link-url" label="URL" help="Use an absolute https:// or http:// URL."><twig:Input id="editor-link-url" name="url" type="url" required/></twig:Field><twig:Button type="submit">Insert link</twig:Button></twig:PreviewForm></twig:Modal>
<twig:Modal id="editor-table-dialog" title="Insert a table"><twig:PreviewForm id="editor-table-form" successMessage="Table added to the local editor."><div class="grid grid-cols-2 gap-5"><twig:Field id="editor-table-rows" label="Rows"><twig:Input id="editor-table-rows" type="number" name="rows" min="1" max="6" value="3" required/></twig:Field><twig:Field id="editor-table-columns" label="Columns"><twig:Input id="editor-table-columns" type="number" name="columns" min="1" max="6" value="3" required/></twig:Field></div><twig:Button type="submit">Insert table</twig:Button></twig:PreviewForm></twig:Modal>
<twig:Modal id="editor-video-dialog" title="Insert an external video"><p class="mb-5 text-sm text-muted">Use a YouTube or Vimeo link. The editor inserts a labeled placeholder and does not contact the video provider.</p><twig:PreviewForm id="editor-video-form" successMessage="Video placeholder added locally. No external video was loaded."><twig:Field id="editor-video-url" label="Video URL" help="https://www.youtube.com/watch?v=… or https://vimeo.com/…"><twig:Input id="editor-video-url" name="url" type="url" required/></twig:Field><twig:Button type="submit">Insert video placeholder</twig:Button></twig:PreviewForm></twig:Modal>
