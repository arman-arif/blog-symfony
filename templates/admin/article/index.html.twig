{% extends 'admin/layout.html.twig' %}
{% block page_title %}Articles{% endblock %}
{% block breadcrumb %}Articles{% endblock %}
{% block eyebrow %}Content / Articles{% endblock %}
{% block heading %}Stories in the making.{% endblock %}
{% block intro %}A shared view of the editorial desk. Filter, sort and select mock records; removal only affects this browser page until reload.{% endblock %}
{% block actions %}<twig:Button href="{{ path('admin_article_create') }}"><twig:Icon name="plus"/>New article</twig:Button>{% endblock %}
{% block content %}
{% set statusOptions = [{value: 'published', label: 'Published'}, {value: 'draft', label: 'Draft'}, {value: 'pending_review', label: 'Pending review'}, {value: 'scheduled', label: 'Scheduled'}, {value: 'unpublished', label: 'Unpublished'}] %}
{% set categoryOptions = [] %}{% for category in categories %}{% set categoryOptions = categoryOptions|merge([{value: category.slug, label: category.name}]) %}{% endfor %}
{% set authorOptions = [] %}{% for author in authors %}{% set authorOptions = authorOptions|merge([{value: author.slug, label: author.displayName}]) %}{% endfor %}
{% set statusTabs = [] %}{% for key, label in {all: 'All', draft: 'Drafts', pending_review: 'Pending', scheduled: 'Scheduled', published: 'Published', trash: 'Trash'} %}{% set statusTabs = statusTabs|merge([{key: key, label: label, href: path('admin_article_index', {tab: key})}]) %}{% endfor %}
<twig:DataTable id="articles-table" caption="Articles" columns="{{ [{key: 'title', label: 'Story', sortable: true}, {key: 'authorName', label: 'Author', sortable: true}, {key: 'status', label: 'Status', sortable: true}, {key: 'views', label: 'Views', sortable: true}, {key: 'updated', label: 'Updated', sortable: true}] }}" filters="{{ [{key: 'status', label: 'Statuses', options: statusOptions}, {key: 'category', label: 'Categories', options: categoryOptions}, {key: 'author', label: 'Authors', options: authorOptions}] }}" state="{{ state }}" tabs="{{ statusTabs }}" trashEnabled>
<twig:block name="bulkActions"><label class="sr-only" for="bulk-article-status">Local status action</label><select id="bulk-article-status" class="field-control w-auto" data-bulk-status><option value="draft">Mark draft</option><option value="pending_review">Submit for review</option><option value="published">Mark published</option><option value="unpublished">Unpublish</option></select><twig:Button size="sm" variant="secondary" data-apply-bulk-status>Apply locally</twig:Button></twig:block>
{% for article in articles %}<tr data-row data-id="{{ article.id }}" data-title="{{ article.title }}" data-search="{{ article.title }} {{ article.author.displayName }}" data-author-name="{{ article.author.displayName }}" data-author="{{ article.author.slug }}" data-status="{{ article.status }}" data-trash="{{ article.deletedAt ? 'true' : 'false' }}" data-category="{{ article.categories|map(category => category.slug)|join(' ') }}" data-views="{{ article.viewCount }}" data-updated="{{ article.updatedAt|date('U') }}">
    <td><input type="checkbox" data-select-row disabled aria-label="Select {{ article.title }}"></td>
    <td><a class="block max-w-xs font-semibold hover:text-brand" href="{{ path('admin_article_edit', {id: article.id}) }}">{{ article.title }}</a><p class="mt-1 text-xs text-muted">{{ article.categories[0].name }} · {{ article.readingTime }} min read{% if article.scheduledAt %} · Scheduled {{ article.scheduledAt|date('M j, Y') }}{% endif %}</p></td>
    <td class="whitespace-nowrap">{{ article.author.displayName }}</td>
    <td><twig:Badge data-status-badge tone="{{ article.status == 'published' ? 'success' : (article.status == 'pending_review' ? 'warning' : (article.status == 'scheduled' ? 'info' : 'neutral')) }}">{{ article.status|replace({'_': ' '})|title }}</twig:Badge><span data-trash-label class="mt-1 block text-xs text-muted" {% if not article.deletedAt %}hidden{% endif %}>In preview trash</span></td>
    <td>{{ article.viewCount|number_format }}</td><td class="whitespace-nowrap"><time datetime="{{ article.updatedAt|date('c') }}">{{ article.updatedAt|date('M j, Y') }}</time></td>
    <td><div class="flex gap-2"><twig:Button variant="ghost" size="sm" href="{{ path('admin_article_preview', {id: article.id}) }}" aria-label="Preview {{ article.title }}">Preview</twig:Button><twig:Button variant="ghost" size="sm" data-component="confirm" data-row-remove data-confirm-message="Move ‘{{ article.title }}’ to local preview trash? No server data will be deleted." aria-label="Move {{ article.title }} to preview trash"><twig:Icon name="trash" size="16"/></twig:Button><button type="button" class="btn btn-ghost btn-sm" data-row-restore {% if not article.deletedAt %}hidden{% endif %}>Restore</button></div></td>
</tr>{% endfor %}
</twig:DataTable>
<p class="mt-4 text-xs text-muted">All mock statuses are available to this preview. Real article editing, workflow permissions and persistence are deliberately deferred.</p>
{% endblock %}
