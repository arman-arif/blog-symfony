{% extends 'admin/layout.html.twig' %}
{% block page_title %}Article preview{% endblock %}
{% block breadcrumb %}Articles / Preview{% endblock %}
{% block heading %}{{ article.title }}{% endblock %}
{% block eyebrow %}Private workspace preview / {{ article.status|replace({'_': ' '}) }}{% endblock %}
{% block intro %}{{ article.subtitle }}{% endblock %}
{% block actions %}<twig:Button href="{{ path('admin_article_edit', {id: article.id}) }}">Back to editor</twig:Button>{% endblock %}
{% block content %}<article class="card mx-auto max-w-4xl p-5 sm:p-9"><p class="mb-5 text-xs text-muted">Mock snapshot · {{ article.author.displayName }} · {{ article.readingTime }} min read · not a public article URL</p>{% if article.featuredImage %}<figure><img src="{{ asset(article.featuredImage.url) }}" width="{{ article.featuredImage.width }}" height="{{ article.featuredImage.height }}" loading="lazy" alt="{{ article.featuredImage.alt }}" class="aspect-video w-full rounded-card object-cover"><figcaption class="mt-2 text-xs text-muted">{{ article.featuredImage.caption }}</figcaption></figure>{% endif %}<div class="prose prose-stone mt-8 max-w-none dark:prose-invert">{% include 'admin/article/editor_content.html.twig' %}</div></article>{% endblock %}
