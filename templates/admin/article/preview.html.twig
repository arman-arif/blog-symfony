{% extends 'admin/layout.html.twig' %}
{% block page_title %}Preview · {{ article.title }}{% endblock %}
{% block breadcrumb %}Articles / Preview{% endblock %}
{% block eyebrow %}Content / Preview{% endblock %}
{% block heading %}{{ article.title }}{% endblock %}
{% block intro %}{{ article.subtitle ?: article.excerpt }}{% endblock %}
{% block actions %}<twig:Button variant="secondary" href="{{ path('admin_article_edit', {id: article.id}) }}">Edit article</twig:Button><twig:Button variant="ghost" href="{{ path('admin_article_revisions', {id: article.id}) }}">Revisions</twig:Button>{% endblock %}
{% block content %}
<div class="mb-6 flex flex-wrap gap-3 text-xs text-muted">
    <span class="badge badge-neutral">{{ article.status.value|replace({'_': ' '})|title }}</span>
    <span>By {{ article.author.displayName }}</span>
    <span>{{ article.readingTime }} min read</span>
    {% if article.publishedAt %}<span>Published {{ article.publishedAt|date('M j, Y') }}</span>{% endif %}
    {% if article.deletedAt %}<span class="badge badge-danger">In trash</span>{% endif %}
</div>
{% if article.featuredImage %}<img class="mb-8 aspect-video w-full rounded-card object-cover" src="{{ asset(article.featuredImage.storageKey) }}" alt="{{ article.featuredImage.alt }}" width="{{ article.featuredImage.width ?: 1200 }}" height="{{ article.featuredImage.height ?: 800 }}">{% endif %}
<div class="prose prose-stone max-w-none dark:prose-invert">{{ article.content|raw }}</div>
{% if article.tags is not empty %}<ul class="mt-8 flex flex-wrap gap-2" aria-label="Tags">{% for tag in article.tags %}<li class="badge badge-neutral">{{ tag.name }}</li>{% endfor %}</ul>{% endif %}
<p class="mt-8 rounded-control bg-canvas p-4 text-xs text-muted">Admin preview of server-sanitized content. It is not a public URL and is visible only to authorized staff.</p>
{% endblock %}
