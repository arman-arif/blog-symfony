{% extends 'admin/layout.html.twig' %}
{% block page_title %}Compare revision{% endblock %}
{% block breadcrumb %}Articles / Revision comparison{% endblock %}
{% block eyebrow %}Revision {{ revision.id }} / Mock comparison{% endblock %}
{% block heading %}See how the story changed.{% endblock %}
{% block intro %}A side-by-side text snapshot. Highlighted fields differ; revision restoration is disabled until the CMS backend is implemented.{% endblock %}
{% block actions %}<twig:Button variant="secondary" href="{{ path('admin_article_revisions', {id: article.id}) }}">All revisions</twig:Button><twig:Button disabled title="Revision restoration is implemented in M5">Restore revision</twig:Button>{% endblock %}
{% block content %}<div class="grid gap-6 lg:grid-cols-2"><section class="card min-w-0 p-6"><h2 class="text-lg font-semibold">Previous snapshot</h2><p class="mt-2 text-xs text-muted">{{ revision.createdBy.displayName }} · {{ revision.createdAt|date('M j, H:i') }}</p><h3 class="mt-6 text-sm font-semibold">Title</h3><p class="mt-2 break-words">{% if revision.title != article.title %}<del class="rounded bg-red-50 p-1 text-red-900 dark:bg-red-950 dark:text-red-200">{{ revision.title }}</del>{% else %}{{ revision.title }}{% endif %}</p><h3 class="mt-6 text-sm font-semibold">Content snapshot</h3><p class="mt-2 text-sm leading-relaxed">{% if revision.content != article.excerpt %}<del class="bg-red-50 text-red-900 dark:bg-red-950 dark:text-red-200">{{ revision.content }}</del>{% else %}{{ revision.content }}{% endif %}</p></section><section class="card min-w-0 p-6"><h2 class="text-lg font-semibold">Current mock version</h2><p class="mt-2 text-xs text-muted">{{ article.author.displayName }} · {{ article.updatedAt|date('M j, Y') }}</p><h3 class="mt-6 text-sm font-semibold">Title</h3><p class="mt-2 break-words">{% if revision.title != article.title %}<ins class="rounded bg-green-50 p-1 text-green-900 dark:bg-green-950 dark:text-green-200">{{ article.title }}</ins>{% else %}{{ article.title }}{% endif %}</p><h3 class="mt-6 text-sm font-semibold">Content snapshot</h3><p class="mt-2 text-sm leading-relaxed">{% if revision.content != article.excerpt %}<ins class="bg-green-50 text-green-900 dark:bg-green-950 dark:text-green-200">{{ article.excerpt }}</ins>{% else %}{{ article.excerpt }}{% endif %}</p></section></div>{% endblock %}
