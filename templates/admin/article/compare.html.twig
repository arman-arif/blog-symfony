{% extends 'admin/layout.html.twig' %}
{% block page_title %}Compare revision · {{ article.title }}{% endblock %}
{% block breadcrumb %}Articles / Revisions / Compare{% endblock %}
{% block eyebrow %}Content / Revision comparison{% endblock %}
{% block heading %}What changed.{% endblock %}
{% block intro %}The selected snapshot is compared with the current saved article.{% endblock %}
{% block actions %}<twig:Button variant="secondary" href="{{ path('admin_article_revisions', {id: article.id}) }}">All revisions</twig:Button>{% endblock %}
{% block content %}
<div class="grid gap-6 lg:grid-cols-2">
    <section class="card p-5" aria-labelledby="revision-heading">
        <h2 id="revision-heading" class="font-display text-2xl">Revision · {{ revision.createdAt|date('M j, Y H:i') }}</h2>
        <p class="mt-1 text-xs text-muted">{{ revision.title }} · {{ revision.isAutosave ? 'Autosave' : 'Manual save' }}</p>
        <div class="prose prose-stone mt-5 max-w-none dark:prose-invert">{{ revision.content|raw }}</div>
    </section>
    <section class="card p-5" aria-labelledby="current-heading">
        <h2 id="current-heading" class="font-display text-2xl">Current article</h2>
        <p class="mt-1 text-xs text-muted">{{ article.updatedAt|date('M j, Y H:i') }}</p>
        <div class="prose prose-stone mt-5 max-w-none dark:prose-invert">{{ article.content|raw }}</div>
    </section>
</div>
<form method="post" action="{{ path('admin_article_restore_revision', {id: article.id, revision: revision.id}) }}" class="mt-6"><input type="hidden" name="_token" value="{{ csrf_token('restore_revision') }}"><twig:Button type="submit" variant="secondary">Restore this revision</twig:Button></form>
{% endblock %}
