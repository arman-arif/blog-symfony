{% extends 'admin/layout.html.twig' %}
{% block page_title %}{{ record.id ? 'Edit' : 'New' }} {{ module }}{% endblock %}
{% block breadcrumb %}{{ module|title }} / {{ record.id ? 'Edit' : 'New' }}{% endblock %}
{% block eyebrow %}Content / {{ module == 'category' ? 'Categories' : 'Tags' }}{% endblock %}
{% block heading %}{{ record.id ? 'Refine the way readers explore.' : 'Give an idea a place to belong.' }}{% endblock %}
{% block intro %}Try names, descriptions and search settings. Nothing is saved; unique slugs and hierarchy rules remain backend work.{% endblock %}
{% block actions %}<twig:Button variant="secondary" href="{{ path('admin_' ~ module ~ '_index') }}">Back to {{ module == 'category' ? 'categories' : 'tags' }}</twig:Button>{% endblock %}
{% block content %}<twig:PreviewStates state="{{ state }}"><twig:PreviewForm data-component="validate content-form" successMessage="{{ module|title }} validated locally. Nothing was saved."><twig:AdminFormLayout sidebarTitle="{{ module|title }} settings"><div class="space-y-6">
<twig:Field id="content-name" label="Name" required><twig:Input id="content-name" name="name" value="{{ record.name }}" required minlength="2" maxlength="100" data-slug-source/></twig:Field><twig:Field id="content-slug" label="URL slug" required help="Lowercase letters, numbers and hyphens. Uniqueness is not checked in this preview."><twig:Input id="content-slug" name="slug" value="{{ record.slug }}" required pattern="[a-z0-9]+(-[a-z0-9]+)*" data-slug-value/></twig:Field><twig:Field id="content-description" label="Description"><twig:Textarea id="content-description" name="description" value="{{ record.description }}" rows="5" maxlength="500"/></twig:Field><twig:SeoFields seo="{{ record.seo|default({title: record.name, description: '', noindex: false}) }}"/>
</div><twig:block name="sidebar"><div class="space-y-6">{% if module == 'category' %}<twig:Field id="content-parent" label="Parent category" help="This preview offers one level of nesting."><select id="content-parent" name="parent" class="field-control"><option value="">No parent · top level</option>{% for category in categories|filter(item => not item.parent and item.id != record.id) %}<option value="{{ category.id }}" {% if record.parent and record.parent.id == category.id %}selected{% endif %}>{{ category.name }}</option>{% endfor %}</select></twig:Field><twig:MediaField image="{{ record.image }}" label="Category image"/>{% endif %}<twig:Button type="submit">Validate {{ module }}</twig:Button><p class="text-xs leading-relaxed text-muted">The public website does not change when you validate this form.</p></div></twig:block></twig:AdminFormLayout></twig:PreviewForm></twig:PreviewStates>{% include 'admin/media/picker.html.twig' %}{% endblock %}
