{% extends 'admin/layout.html.twig' %}
{% set plural = module == 'category' ? 'Categories' : 'Tags' %}
{% block page_title %}{{ plural }}{% endblock %}
{% block breadcrumb %}{{ plural }}{% endblock %}
{% block eyebrow %}Content / Organisation{% endblock %}
{% block heading %}{{ module == 'category' ? 'Make every story easy to find.' : 'Small connections, bigger discoveries.' }}{% endblock %}
{% block intro %}{{ module == 'category' ? 'Organise your journal with a clear hierarchy. Indented entries belong to the category above them.' : 'Connect related ideas across your journal with thoughtfully chosen topics.' }} All changes are local previews.{% endblock %}
{% block actions %}<twig:Button variant="secondary" href="{{ path(module == 'category' ? 'admin_tag_index' : 'admin_category_index') }}">{{ module == 'category' ? 'Manage tags' : 'Manage categories' }}</twig:Button><twig:Button href="{{ path('admin_' ~ module ~ '_create') }}">New {{ module }}</twig:Button>{% endblock %}
{% block content %}
{% set ordered = records %}{% if module == 'category' %}{% set ordered = [] %}{% for root in records|filter(item => not item.parent) %}{% set ordered = ordered|merge([root])|merge(records|filter(item => item.parent and item.parent.id == root.id)) %}{% endfor %}{% endif %}
<twig:DataTable id="taxonomy-table" caption="{{ plural }}" columns="{{ [{key: 'name', label: 'Name', sortable: true}, {key: 'slug', label: 'Slug', sortable: true}, {key: 'description', label: 'Description'}, {key: 'views', label: 'Articles', sortable: true}] }}" state="{{ state }}">
{% for item in ordered %}<tr data-row data-id="{{ item.id }}" data-name="{{ item.name }}" data-slug="{{ item.slug }}" data-views="{{ item.articleCount }}" data-search="{{ item.name }} {{ item.slug }} {{ item.description }}">
<td><input type="checkbox" data-select-row disabled aria-label="Select {{ item.name }}"></td><td><a href="{{ path('admin_' ~ module ~ '_edit', {id: item.id}) }}" class="font-semibold hover:text-brand {{ item.parent|default(null) ? 'ml-5 border-l-2 border-line pl-3' : '' }}">{% if item.parent|default(null) %}<span class="sr-only">Child of {{ item.parent.name }}: </span>{% endif %}{{ item.name }}</a></td><td class="text-muted">{{ item.slug }}</td><td class="max-w-sm text-muted">{{ item.description }}</td><td>{{ item.articleCount }}</td><td><div class="flex gap-2"><twig:Button variant="ghost" size="sm" href="{{ path('admin_' ~ module ~ '_edit', {id: item.id}) }}">Edit</twig:Button><twig:Button variant="ghost" size="sm" data-component="confirm" data-row-remove data-confirm-message="Remove {{ item.name }} from this local preview? Related articles and server records are unchanged." aria-label="Remove {{ item.name }} locally"><twig:Icon name="trash" size="16"/></twig:Button></div></td></tr>{% endfor %}
</twig:DataTable>
<p class="mt-4 text-xs text-muted">Sorting flattens this tree preview. Parent relationships and slug uniqueness will be enforced by the backend.</p>
{% endblock %}
