{% extends 'base.html.twig' %}
{% block title %}{{ status_code }} · Fieldnotes{% endblock %}
{% block body %}<header class="container-editorial py-7"><a class="font-display text-4xl" href="{{ path('front_home') }}">fieldnotes<span class="text-accent">.</span></a></header><main id="main-content" class="container-editorial flex min-h-[65vh] flex-col items-center justify-center py-16 text-center"><p class="eyebrow">{{ status_code }} / {{ status_text }}</p><p class="my-6 font-display text-[7rem] leading-none text-brand/20 sm:text-[12rem]" aria-hidden="true">{{ status_code }}</p><h1 class="font-display text-4xl sm:text-5xl">{{ error_title|default('A small detour.') }}</h1><p class="mt-5 max-w-lg text-sm leading-7 text-muted">{{ error_copy|default('We could not complete this request. Try again, or return to the journal for something worth reading.') }}</p><div class="mt-8 flex flex-wrap justify-center gap-3"><twig:Button href="{{ path('front_blog') }}">Back to the journal<twig:Icon name="arrow"/></twig:Button><twig:Button variant="secondary" href="{{ path('front_page', {slug: 'contact'}) }}">Get in touch</twig:Button></div></main><footer class="container-editorial border-t border-line py-8 text-center text-xs text-muted">Good stories are still waiting for you.</footer>{% endblock %}
