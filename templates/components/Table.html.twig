{% props caption, columns, tableClass = '' %}
<div {{ attributes.defaults({class: 'table-shell', tabindex: '0', role: 'region', 'aria-label': caption ~ ' table, scroll horizontally on small screens'}) }}><table class="data-table {{ tableClass }}"><caption class="sr-only">{{ caption }}</caption><thead><tr>{% for label in columns %}<th scope="col">{{ label }}</th>{% endfor %}</tr></thead><tbody>{% block content %}{% endblock %}</tbody></table></div>
