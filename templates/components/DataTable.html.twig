{% props id, caption, columns, filters = [], state = '', tabs = [], trashEnabled = false %}
<section id="{{ id }}" data-component="data-table" data-table-state="{{ state }}" data-trash-enabled="{{ trashEnabled ? 'true' : 'false' }}" {{ attributes.defaults({class: 'card min-w-0 overflow-hidden'}) }}>
    {% if tabs %}<nav class="flex flex-wrap gap-1 border-b border-line p-3" aria-label="Article status views">{% for tab in tabs %}<a href="{{ tab.href }}" data-table-tab="{{ tab.key }}" class="btn btn-ghost btn-sm">{{ tab.label }}</a>{% endfor %}</nav>{% endif %}
    <form class="grid gap-4 border-b border-line p-5 sm:grid-cols-2 xl:flex xl:flex-wrap xl:items-end" data-table-filters role="search" aria-label="Filter {{ caption }}">
        <div class="min-w-0 xl:flex-1"><label class="field-label" for="{{ id }}-query">Search {{ caption|lower }}</label><input class="field-control" id="{{ id }}-query" name="q" type="search" placeholder="Search by title or author" data-filter="q"></div>
        {% for filter in filters %}<div><label class="field-label" for="{{ id }}-{{ filter.key }}">{{ filter.label }}</label><select class="field-control" id="{{ id }}-{{ filter.key }}" name="{{ filter.key }}" data-filter="{{ filter.key }}"><option value="">All {{ filter.label|lower }}</option>{% for option in filter.options %}<option value="{{ option.value }}">{{ option.label }}</option>{% endfor %}</select></div>{% endfor %}
        <div><label class="field-label" for="{{ id }}-per-page">Per page</label><select class="field-control" id="{{ id }}-per-page" name="perPage" data-per-page><option>10</option><option>20</option><option>50</option></select></div>
        <twig:Button variant="secondary" type="reset">Reset filters</twig:Button>
    </form>
    <noscript><p class="p-5 text-sm text-muted">All mock rows are shown. Enable JavaScript for filtering, sorting, pagination and local-only actions.</p></noscript>
    <div class="flex flex-wrap items-center gap-3 border-b border-line bg-brand/5 px-5 py-3" data-bulk-bar hidden><p class="mr-auto text-sm font-semibold"><span data-selected-count>0</span> selected</p>{% block bulkActions %}{% endblock %}<twig:Button size="sm" variant="secondary" data-clear-selection>Clear selection</twig:Button><twig:Button size="sm" variant="danger" data-component="confirm" data-bulk-remove data-confirm-message="Remove the selected rows from this local preview? Nothing is deleted from the server.">{{ trashEnabled ? 'Move to preview trash' : 'Remove selected' }}</twig:Button>{% if trashEnabled %}<twig:Button size="sm" variant="secondary" data-bulk-restore hidden>Restore selected locally</twig:Button>{% endif %}</div>
    <div data-table-loading hidden class="space-y-4 p-6" role="status" aria-label="Loading rows"><twig:Skeleton lines="4"/></div>
    <div data-table-error hidden class="p-6"><twig:Alert tone="danger" title="The table could not be loaded">This is a simulated error. <button type="button" class="underline" data-table-retry>Try again</button> to return to the mock records.</twig:Alert></div>
    <div data-table-empty hidden class="p-8"><twig:EmptyState title="No records yet" description="Your next story begins here. This empty collection is a UI preview."/></div>
    <div data-table-no-results hidden class="p-8"><twig:EmptyState title="No matching records" description="Try a shorter search or clear your filters."/><div class="mt-4 text-center"><twig:Button variant="secondary" data-reset-filters>Clear filters</twig:Button></div></div>
    <div class="overflow-x-auto" data-table-content tabindex="0" role="region" aria-label="{{ caption }} table, scroll horizontally on small screens">
        <table class="data-table min-w-[760px]"><caption class="sr-only">{{ caption }} — mock records, local-only actions</caption><thead><tr><th scope="col"><input type="checkbox" data-select-all disabled aria-label="Select all rows on this page"></th>{% for column in columns %}<th scope="col" {% if column.sortable|default(false) %}aria-sort="none"{% endif %}>{% if column.sortable|default(false) %}<button type="button" data-sort="{{ column.key }}" class="inline-flex min-h-9 items-center gap-2" disabled>{{ column.label }}<span data-sort-indicator aria-hidden="true">↕</span></button>{% else %}{{ column.label }}{% endif %}</th>{% endfor %}<th scope="col">Actions</th></tr></thead><tbody>{% block content %}{% endblock %}</tbody></table>
    </div>
    <div class="flex flex-wrap items-center justify-between gap-4 border-t border-line p-5" data-table-pagination hidden><p class="text-sm text-muted" data-table-summary role="status" aria-live="polite"></p><nav class="flex items-center gap-3" aria-label="Table pagination"><twig:Button variant="secondary" size="sm" data-page-prev>Previous</twig:Button><span class="text-sm" data-page-label></span><twig:Button variant="secondary" size="sm" data-page-next>Next</twig:Button></nav></div>
</section>
