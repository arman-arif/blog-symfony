{% props id, label, help = '', error = '', required = false %}
<div {{ attributes }}>
    <label class="field-label" for="{{ id }}">{{ label }}{% if required %}<span class="text-danger" aria-hidden="true"> *</span>{% endif %}</label>
    {% block content %}{% endblock %}
    {% if help %}<p id="{{ id }}-help" class="field-help">{{ help }}</p>{% endif %}
    <p id="{{ id }}-error" class="field-error" {% if not error %}hidden{% endif %}>{{ error }}</p>
</div>
