{% props id, label, type = 'checkbox', name = null, checked = false %}
<label class="inline-flex min-h-11 items-center gap-3 text-sm" for="{{ id }}">
<input id="{{ id }}" name="{{ name ?? id }}" type="{{ type == 'toggle' ? 'checkbox' : type }}" {% if type == 'toggle' %}role="switch"{% endif %} {% if checked %}checked{% endif %} {{ attributes.defaults({class: 'rounded border-line bg-surface text-brand focus:ring-brand'}) }}>{{ label }}
</label>
