{% props id = 'article-content', article, label = 'Article content', contentTemplate = 'admin/article/editor_content.html.twig', outputName = 'content' %}
<div data-component="editor" data-editor-id="{{ id }}" class="rich-editor min-w-0">
    <p id="{{ id }}-label" class="field-label">{{ label }}</p><p id="{{ id }}-help" class="mb-3 text-xs text-muted">Formatting stays in this page. No autosave or server storage is active.</p>
    <div data-editor-toolbar class="flex flex-wrap items-center gap-1 rounded-t-control border border-line bg-canvas p-2" role="group" aria-label="Content formatting">
        <label class="sr-only" for="{{ id }}-heading">Text style</label><select id="{{ id }}-heading" data-editor-heading class="field-control w-auto min-w-28"><option value="0">Paragraph</option><option value="2">Heading 2</option><option value="3">Heading 3</option></select>
        {% for format, label in {bold: 'Bold', italic: 'Italic', underline: 'Underline', blockquote: 'Blockquote', 'code-block': 'Code block'} %}<button type="button" class="btn btn-ghost btn-sm" data-editor-format="{{ format }}" aria-label="{{ label }}" aria-pressed="false">{{ format == 'bold' ? 'B' : (format == 'italic' ? 'I' : (format == 'underline' ? 'U' : label)) }}</button>{% endfor %}
        <button type="button" class="btn btn-ghost btn-sm" data-editor-list="bullet" aria-label="Bulleted list" aria-pressed="false">• List</button><button type="button" class="btn btn-ghost btn-sm" data-editor-list="ordered" aria-label="Numbered list" aria-pressed="false">1. List</button>
        <label class="sr-only" for="{{ id }}-align">Text alignment</label><select id="{{ id }}-align" data-editor-align class="field-control w-auto"><option value="">Align left</option><option value="center">Center</option><option value="right">Align right</option><option value="justify">Justify</option></select>
        <button type="button" class="btn btn-ghost btn-sm" data-editor-action="link">Link</button><button type="button" class="btn btn-ghost btn-sm" data-dialog-open="media-picker" data-media-target="editor" data-editor-action="image">Image</button><button type="button" class="btn btn-ghost btn-sm" data-editor-action="table">Table</button><button type="button" class="btn btn-ghost btn-sm" data-editor-action="video">Video</button><button type="button" class="btn btn-ghost btn-sm" data-editor-action="divider">Separator</button><button type="button" class="btn btn-ghost btn-sm" data-editor-action="undo" aria-label="Undo">↶ Undo</button><button type="button" class="btn btn-ghost btn-sm" data-editor-action="redo" aria-label="Redo">↷ Redo</button>
    </div>
    <div id="{{ id }}" data-editor-surface aria-labelledby="{{ id }}-label" aria-describedby="{{ id }}-help" class="rounded-b-control border border-line bg-surface p-5">{% if article.id %}{% include contentTemplate %}{% else %}<p><br></p>{% endif %}</div>
    <textarea name="{{ outputName }}" data-editor-output hidden readonly aria-hidden="true"></textarea>
    <div class="mt-3 flex flex-wrap items-center justify-between gap-2"><p class="text-xs text-muted" data-editor-count>Read-only until the editor loads.</p><div class="flex flex-wrap gap-2"><button type="button" class="btn btn-ghost btn-sm" data-editor-table-action="insertRowBelow">Add table row</button><button type="button" class="btn btn-ghost btn-sm" data-editor-table-action="insertColumnRight">Add column</button><button type="button" class="btn btn-ghost btn-sm" data-editor-table-action="deleteTable">Remove table</button></div></div>
    <p class="field-error" data-editor-error hidden>{{ label }} needs at least 20 characters.</p>
</div>
