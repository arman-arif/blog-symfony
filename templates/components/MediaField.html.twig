{% props image = null, label = 'Image', target = 'content-image', name = 'image' %}
<div data-media-field="{{ target }}"><p class="field-label">{{ label }}</p><img data-content-image {% if not image %}hidden{% endif %} {% if image %}src="{{ asset(image.url) }}"{% endif %} alt="{{ image ? image.alt : '' }}" width="1200" height="800" class="mb-3 aspect-video w-full rounded-control object-cover"><input type="hidden" name="{{ name }}" value="{{ image ? image.id : '' }}" data-content-image-id><div class="flex flex-wrap gap-2"><twig:Button variant="secondary" size="sm" data-dialog-open="media-picker" data-media-target="{{ target }}">Choose {{ label|lower }}</twig:Button><twig:Button variant="ghost" size="sm" data-content-image-remove>Remove</twig:Button></div><p class="mt-2 text-xs text-muted">Local selection only. No file is uploaded.</p></div>
