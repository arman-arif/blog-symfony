{% props name, url = null, size = 'md' %}
{% set sizes = {sm: 'h-8 w-8 text-xs', md: 'h-11 w-11 text-sm', lg: 'h-20 w-20 text-xl'} %}
<span {{ attributes.defaults({class: 'inline-flex shrink-0 items-center justify-center overflow-hidden rounded-full bg-brand/10 font-bold text-brand ' ~ sizes[size]}) }}>
{% if url %}<img src="{{ asset(url) }}" alt="{{ name }}" width="80" height="80" loading="lazy">{% else %}<span aria-hidden="true">{{ name|split(' ')|map(part => part|first)|join('')|slice(0, 2) }}</span><span class="sr-only">{{ name }}</span>{% endif %}
</span>
