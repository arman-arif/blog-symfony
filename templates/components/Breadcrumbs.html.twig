{% props items %}
<nav aria-label="Breadcrumb" {{ attributes }}><ol class="flex flex-wrap items-center gap-2 text-xs text-muted">{% for item in items %}<li class="flex items-center gap-2">{% if not loop.first %}<span aria-hidden="true">/</span>{% endif %}{% if item.href is defined %}<a class="hover:text-brand" href="{{ item.href }}">{{ item.label }}</a>{% else %}<span aria-current="page">{{ item.label }}</span>{% endif %}</li>{% endfor %}</ol></nav>
