<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <meta name="description" content="{% block description %}Thoughtful stories on design, technology and living well. Independent ideas for curious minds.{% endblock %}">
        <link rel="icon" href="{{ asset('icons/favicon.svg') }}" type="image/svg+xml">
        {% block stylesheets %}
            <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}

    </head>
    <body>
        <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:left-5 focus:top-5 focus:z-50 focus:rounded-control focus:bg-surface focus:p-4">Skip to content</a>
        {% include 'partials/flashes.html.twig' %}
        {% block body %}{% endblock %}
        {% include 'partials/feedback.html.twig' %}
    </body>
</html>
