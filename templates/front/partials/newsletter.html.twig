<section id="newsletter" class="scroll-mt-24 border-y border-line bg-brand/5 py-16 sm:py-20"><div class="container-editorial grid items-center gap-10 lg:grid-cols-2"><div><p class="eyebrow">The Sunday letter</p><h2 class="section-title mt-4">Good stories. A quieter inbox.</h2><p class="mt-4 max-w-lg text-sm leading-7 text-muted">A handpicked collection of our favourite stories and discoveries, delivered once a week. Something worth opening.</p></div><form method="post" action="{{ path('front_newsletter_subscribe') }}" class="space-y-3"><input type="hidden" name="_token" value="{{ csrf_token('newsletter_subscribe') }}"><div class="flex flex-col gap-3 sm:flex-row sm:items-end"><twig:Field id="newsletter-email" label="Email address" class="flex-1" required><twig:Input id="newsletter-email" name="email" type="email" required placeholder="Your email address" autocomplete="email"/></twig:Field><twig:Button type="submit" class="shrink-0">Count me in<twig:Icon name="arrow"/></twig:Button></div><p class="text-xs text-muted">One thoughtful email a week. Unsubscribe anytime. <a class="underline" href="{{ path('front_page', {slug: 'privacy'}) }}">Privacy policy</a></p></form></div></section>
