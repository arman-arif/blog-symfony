{% extends 'front/layout.html.twig' %}
{% block title %}{{ slug|capitalize }} · Fieldnotes{% endblock %}
{% block description %}{{ page.description }}{% endblock %}
{% block content %}<section class="container-editorial py-16 sm:py-24"><div class="mx-auto max-w-3xl"><p class="eyebrow">{{ page.eyebrow }}</p><h1 class="mt-5 font-display text-5xl leading-tight sm:text-6xl">{{ page.title }}</h1><p class="mt-8 text-lg leading-8 text-muted">{{ page.description }}</p>
{% if slug == 'contact' %}{% include 'front/page/contact_form.html.twig' %}{% else %}<div class="mt-12 space-y-9">{% for section in page.sections %}<section><h2 class="font-display text-3xl">{{ section.title }}</h2><p class="mt-4 text-sm leading-8 text-muted">{{ section.text }}</p></section>{% endfor %}</div>{% endif %}
{% if slug == 'about' %}<div class="mt-12 card p-7"><p class="eyebrow">Meet the people behind the journal</p><div class="mt-6 flex flex-wrap gap-4">{% for author in authors %}<a href="{{ path('front_author', {slug: author.slug}) }}" aria-label="Meet {{ author.displayName }}"><twig:Avatar name="{{ author.displayName }}"/></a>{% endfor %}</div><a class="mt-6 inline-block font-semibold text-brand" href="{{ path('front_authors') }}">Our contributors →</a></div>{% endif %}
{% if slug == 'cookies' %}<twig:Button class="mt-10" data-consent-settings>Manage cookie preferences</twig:Button>{% endif %}
<div class="mt-10"><twig:Button href="{{ path('front_blog') }}" variant="secondary">Explore the journal<twig:Icon name="arrow"/></twig:Button></div></div></section>{% endblock %}
