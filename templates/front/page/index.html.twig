{% extends 'front/layout.html.twig' %}
{% set pages = {about: {title: 'A journal for the things that matter.', copy: 'Fieldnotes is an independent space for thoughtful ideas. We believe good stories can help us see the everyday differently, ask better questions and live with more intention.'}, contact: {title: 'Let’s start a conversation.', copy: 'Have a story idea, a thoughtful question or feedback on our journal? Our editorial team would love to hear from you. This is a preview; contact delivery will be connected during backend integration.'}, privacy: {title: 'Your privacy matters.', copy: 'This preview does not create accounts, send messages or store submitted email addresses. Theme preferences are stored locally in your browser. The production privacy policy will be reviewed before any personal-data collection is enabled.'}, terms: {title: 'A thoughtful space, shared responsibly.', copy: 'These preview terms describe an editorial demonstration, not a production service. Original articles, illustrations and site design belong to their respective creators. Please share links rather than reproducing entire stories.'}, cookies: {title: 'A clear note about cookies.', copy: 'No advertising or analytics tracking is active in this preview. The light/dark preference uses local browser storage. Essential session cookies will be documented when authentication is implemented.'}} %}
{% set page = pages[slug] %}
{% block title %}{{ slug|capitalize }} · Fieldnotes{% endblock %}
{% block content %}<section class="container-editorial py-16 sm:py-24"><div class="mx-auto max-w-3xl"><p class="eyebrow">{{ slug|capitalize }}</p><h1 class="mt-5 font-display text-5xl leading-tight sm:text-6xl">{{ page.title }}</h1><p class="mt-8 text-lg leading-8 text-muted">{{ page.copy }}</p><div class="mt-10"><twig:Button href="{{ path('front_blog') }}">Explore the journal<twig:Icon name="arrow"/></twig:Button></div></div></section>{% endblock %}
