{% extends 'base.html.twig' %}
{% block body %}
<div class="border-b border-line bg-brand/5 py-2.5 text-center text-xs text-muted">An independent journal for curious minds. <a class="font-semibold text-brand underline underline-offset-4" href="#newsletter">A little inspiration, every Sunday <span aria-hidden="true">↗</span></a></div>
<header class="sticky top-0 z-30 border-b border-line bg-canvas/95 backdrop-blur">
<div class="container-editorial flex h-20 items-center justify-between gap-4">
<a href="{{ path('front_home') }}" class="font-display text-4xl font-medium tracking-tight" aria-label="Fieldnotes home">fieldnotes<span class="text-accent">.</span></a>
<nav class="hidden items-center gap-7 lg:flex" aria-label="Main navigation"><a href="{{ path('front_blog') }}" class="text-sm font-semibold hover:text-brand">Journal</a><twig:Dropdown id="header-categories" label="Explore">{% for category in categories|slice(0, 6) %}<a class="dropdown-item" href="{{ path('front_blog', {category: category.slug}) }}">{{ category.name }}</a>{% endfor %}</twig:Dropdown><a href="{{ path('front_page', {slug: 'about'}) }}" class="text-sm font-semibold hover:text-brand">Our story</a></nav>
<div class="flex items-center gap-1 sm:gap-2"><twig:Button variant="ghost" size="icon" data-dialog-open="site-search" aria-label="Search stories"><twig:Icon name="search"/></twig:Button><twig:Button variant="ghost" size="icon" data-component="theme" aria-pressed="false" aria-label="Toggle dark mode"><twig:Icon name="sun"/></twig:Button><twig:Button href="#newsletter" class="hidden sm:inline-flex">Subscribe<twig:Icon name="arrow"/></twig:Button><twig:Button variant="ghost" size="icon" data-dialog-open="mobile-navigation" class="lg:hidden" aria-label="Open navigation"><twig:Icon name="menu"/></twig:Button></div>
</div></header>
<main id="main-content">{% block content %}{% endblock %}</main>
{% include 'front/partials/newsletter.html.twig' %}
<footer class="container-editorial pb-8 pt-16"><div class="grid gap-10 border-b border-line pb-12 sm:grid-cols-2 lg:grid-cols-4"><div class="lg:col-span-2"><a href="{{ path('front_home') }}" class="font-display text-4xl">fieldnotes<span class="text-accent">.</span></a><p class="mt-4 max-w-sm text-sm leading-6 text-muted">A collection of thoughtful stories, fresh perspectives and ideas for living a little more intentionally.</p><div class="mt-5 flex gap-5 text-sm"><a href="https://www.instagram.com/" rel="noopener noreferrer" class="text-muted hover:text-brand">Instagram</a><a href="https://www.linkedin.com/" rel="noopener noreferrer" class="text-muted hover:text-brand">LinkedIn</a><a href="{{ path('front_page', {slug: 'contact'}) }}" class="text-muted hover:text-brand">Get in touch</a></div></div><div><h2 class="text-sm font-semibold">Explore the journal</h2><ul class="mt-5 space-y-3 text-sm text-muted">{% for category in categories|slice(0, 4) %}<li><a href="{{ path('front_blog', {category: category.slug}) }}" class="hover:text-brand">{{ category.name }}</a></li>{% endfor %}</ul></div><div><h2 class="text-sm font-semibold">A note from us</h2><p class="my-4 text-xs leading-6 text-muted">One thoughtful email. No noise.<br>Preview only — no email is sent.</p><form data-component="validate" class="space-y-3"><twig:Field id="footer-email" label="Your email"><twig:Input id="footer-email" type="email" required placeholder="you@example.com" autocomplete="email"/></twig:Field><twig:Button type="submit" variant="secondary" class="w-full">Join the list</twig:Button></form></div></div><div class="flex flex-col justify-between gap-4 pt-6 text-xs text-muted sm:flex-row"><p>© {{ 'now'|date('Y') }} Fieldnotes. Made with care.</p><nav class="flex flex-wrap gap-5" aria-label="Legal navigation">{% for slug, title in {privacy: 'Privacy', terms: 'Terms', cookies: 'Cookies'} %}<a href="{{ path('front_page', {slug: slug}) }}">{{ title }}</a>{% endfor %}</nav></div></footer>
<twig:Modal id="mobile-navigation" title="Explore Fieldnotes" drawer><nav class="space-y-2" aria-label="Mobile navigation"><a class="dropdown-item" href="{{ path('front_blog') }}">All stories</a>{% for category in categories|slice(0, 6) %}<a class="dropdown-item" href="{{ path('front_blog', {category: category.slug}) }}">{{ category.name }}</a>{% endfor %}<a class="dropdown-item" href="{{ path('front_page', {slug: 'about'}) }}">Our story</a><a class="dropdown-item" href="{{ path('front_page', {slug: 'contact'}) }}">Contact</a></nav></twig:Modal>
<twig:Modal id="site-search" title="Find your next great read"><form action="{{ path('front_blog') }}" method="get" class="space-y-5"><twig:Field id="header-query" label="Search the journal" help="Try design, nature or creative work."><twig:Input id="header-query" name="q" type="search" placeholder="What are you curious about?"/></twig:Field><twig:Button type="submit">Search stories<twig:Icon name="search"/></twig:Button></form></twig:Modal>
{% endblock %}
