{% extends 'front/layout.html.twig' %}
{% set name = kind == 'author' ? collection.displayName : collection.name %}
{% block title %}{{ name }} · Fieldnotes{% endblock %}
{% block content %}<section class="container-editorial py-12 sm:py-16"><twig:Breadcrumbs items="{{ [{label: 'Home', href: path('front_home')}, {label: kind == 'author' ? 'Authors' : kind == 'category' ? 'Categories' : 'Topics', href: path(kind == 'author' ? 'front_authors' : kind == 'category' ? 'front_categories' : 'front_tags')}, {label: name}] }}"/><div class="mt-10 border-b border-line pb-10 {{ kind == 'author' ? 'flex flex-col gap-6 sm:flex-row sm:items-center' : '' }}">{% if kind == 'author' %}<twig:Avatar name="{{ name }}" size="lg"/>{% endif %}<div><p class="eyebrow">{{ kind == 'author' ? collection.jobTitle : kind == 'category' ? 'A fresh perspective on' : 'Stories tagged' }}</p><h1 class="mt-4 font-display text-5xl sm:text-6xl">{{ kind == 'tag' ? '#' : '' }}{{ name }}</h1><p class="mt-5 max-w-2xl text-sm leading-7 text-muted">{{ kind == 'author' ? collection.bio : collection.description }}</p><p class="mt-4 text-xs text-muted">{{ total }} {{ total == 1 ? 'story' : 'stories' }} in this collection</p></div></div><div class="mt-10">{% if articles %}<div class="grid gap-x-7 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">{% for article in articles %}<twig:ArticleCard article="{{ article }}"/>{% endfor %}</div>{% else %}<twig:EmptyState title="New stories are taking shape" description="There are no published stories in this collection yet. Explore the journal while we work on something worth your time."><twig:Button href="{{ path('front_blog') }}">Browse all stories</twig:Button></twig:EmptyState>{% endif %}</div><twig:Pagination route="{{ 'front_' ~ kind }}" query="{{ {slug: collection.slug} }}" page="{{ page }}" pages="{{ pages }}"/></section>{% endblock %}
