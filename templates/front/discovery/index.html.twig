{% extends 'front/layout.html.twig' %}
{% set titles = {author: 'Different voices. Shared curiosity.', category: 'Find your corner of the world.', tag: 'Follow a new thread.'} %}
{% block title %}{{ kind == 'author' ? 'Authors' : kind == 'category' ? 'Categories' : 'Topics' }} · Fieldnotes{% endblock %}
{% block content %}<section class="container-editorial py-14 sm:py-20"><p class="eyebrow">{{ kind == 'author' ? 'Our contributors' : 'Explore the journal' }}</p><h1 class="mt-5 font-display text-display">{{ titles[kind] }}</h1><p class="mt-6 max-w-xl text-muted">{{ kind == 'author' ? 'Meet the writers, makers and observers bringing fresh perspectives to Fieldnotes.' : 'There is always something new to notice. Choose a subject and see where it takes you.' }}</p>
{% if kind == 'author' %}<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{% for author in authors %}<article class="card p-7"><twig:Avatar name="{{ author.displayName }}" size="lg"/><p class="eyebrow mt-6">{{ author.jobTitle }}</p><h2 class="mt-3 font-display text-3xl"><a href="{{ path('front_author', {slug: author.slug}) }}" class="hover:text-brand">{{ author.displayName }}</a></h2><p class="mt-4 text-sm leading-7 text-muted">{{ author.bio }}</p><a class="mt-6 inline-block text-sm font-semibold text-brand" href="{{ path('front_author', {slug: author.slug}) }}">Read their stories →</a></article>{% endfor %}</div>
{% elseif kind == 'category' %}<div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">{% for category in categories %}<article class="card overflow-hidden"><img src="{{ asset(category.image.url) }}" alt="{{ category.image.alt }}" width="1200" height="800" loading="lazy" class="aspect-[3/2] w-full object-cover"><div class="p-6">{% if category.parent %}<p class="eyebrow mb-3">Within {{ category.parent.name }}</p>{% endif %}<h2 class="font-display text-3xl"><a href="{{ path('front_category', {slug: category.slug}) }}" class="hover:text-brand">{{ category.name }}</a></h2><p class="mt-3 text-sm leading-7 text-muted">{{ category.description }}</p><a class="mt-5 inline-block text-sm font-semibold text-brand" href="{{ path('front_category', {slug: category.slug}) }}">Explore stories →</a></div></article>{% endfor %}</div>
{% else %}<div class="mt-12 flex flex-wrap gap-3">{% for tag in tags %}<a class="btn btn-secondary text-left" href="{{ path('front_tag', {slug: tag.slug}) }}">#{{ tag.name }}<twig:Icon name="arrow" size="16"/></a>{% endfor %}</div>{% endif %}</section>{% endblock %}
