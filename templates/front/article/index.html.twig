{% extends 'front/layout.html.twig' %}
{% block title %}{{ article.title }} · Fieldnotes{% endblock %}
{% block description %}{{ article.excerpt }}{% endblock %}
{% block content %}
{% set primaryCategory = article.categories|first %}
<article class="container-editorial py-10 sm:py-14" data-component="reader" data-article-id="{{ article.id }}">
<div class="fixed left-0 right-0 top-0 z-50 h-1 origin-left scale-x-0 bg-accent" data-reading-progress aria-hidden="true"></div>
<div class="mx-auto max-w-4xl"><twig:Breadcrumbs items="{{ [{label: 'Journal', href: path('front_blog')}, {label: primaryCategory ? primaryCategory.name : 'Story', href: primaryCategory ? path('front_blog', {category: primaryCategory.slug}) : path('front_blog')}, {label: 'Story'}] }}"/><p class="eyebrow mt-8">{{ primaryCategory ? primaryCategory.name : 'Journal' }}</p><h1 class="mt-4 font-display text-4xl font-medium leading-tight sm:text-6xl">{{ article.title }}</h1><p class="mt-5 text-lg leading-8 text-muted">{{ article.subtitle }}</p><div class="my-8 flex flex-wrap items-center justify-between gap-5"><div class="flex items-center gap-3"><twig:Avatar name="{{ article.author.displayName }}"/><div><a href="{{ path('front_blog', {author: article.author.slug}) }}" class="text-sm font-semibold">{{ article.author.displayName }}</a><p class="mt-1 text-xs text-muted"><time datetime="{{ article.publishedAt|date('c') }}">{{ article.publishedAt|date('F j, Y') }}</time> · {{ article.readingTime }} min read</p></div></div><twig:Button variant="secondary" size="icon" data-engagement="bookmark" aria-label="Save story for later in this browser preview" aria-pressed="false"><twig:Icon name="bookmark"/></twig:Button></div>{% if article.featuredImage %}<figure><img src="{{ media_url(article.featuredImage) }}" alt="{{ article.featuredImage.alt }}" width="{{ article.featuredImage.width ?: 1200 }}" height="{{ article.featuredImage.height ?: 800 }}" loading="lazy" class="w-full rounded-card">{% if article.featuredImage.caption %}<figcaption class="mt-3 text-xs text-muted">{{ article.featuredImage.caption }}</figcaption>{% endif %}</figure>{% endif %}</div>
<div class="mx-auto mt-12 grid max-w-5xl gap-10 lg:grid-cols-[13rem_minmax(0,1fr)]"><aside class="lg:sticky lg:top-28 lg:self-start"><p class="eyebrow mb-4">In this story</p><nav data-toc aria-label="Table of contents"></nav><noscript><p class="text-sm text-muted">Continue below to read the full story.</p></noscript></aside><div class="min-w-0"><div class="prose prose-lg max-w-none dark:prose-invert" data-article-content>{% if article.content %}{{ article.content|raw }}{% else %}<p>{{ article.excerpt }}</p>{% endif %}</div>
<nav class="my-8 flex flex-wrap gap-2" aria-label="Article topics">{% for tag in article.tags %}<a class="badge badge-neutral" href="{{ path('front_blog', {tag: tag.slug}) }}">#{{ tag.name }}</a>{% endfor %}</nav>
<div class="flex flex-wrap items-center justify-between gap-4 border-y border-line py-5"><twig:Button variant="secondary" data-engagement="like" aria-pressed="false" aria-label="Like story in this browser preview"><twig:Icon name="heart"/><span data-count>{{ article.likeCount }}</span></twig:Button><div class="flex flex-wrap gap-2"><twig:Button variant="secondary" data-copy-link><twig:Icon name="copy"/>Copy link</twig:Button><a class="btn btn-secondary" href="https://www.linkedin.com/sharing/share-offsite/?url={{ url('front_article', {slug: article.slug})|url_encode }}" target="_blank" rel="noopener noreferrer" aria-label="Share story on LinkedIn (opens in a new tab)">LinkedIn ↗</a><a class="btn btn-secondary" href="mailto:?subject={{ article.title|url_encode }}&amp;body={{ url('front_article', {slug: article.slug})|url_encode }}">Email</a></div></div>
<section class="card my-8 flex gap-5 p-6" aria-labelledby="author-bio-title"><twig:Avatar name="{{ article.author.displayName }}"/><div><p class="eyebrow">Written by</p><h2 id="author-bio-title" class="mt-2 font-display text-2xl">{{ article.author.displayName }}</h2><p class="mt-3 text-sm leading-7 text-muted">{{ article.author.bio }}</p><a href="{{ path('front_blog', {author: article.author.slug}) }}" class="mt-3 inline-block text-sm font-semibold text-brand">More from {{ article.author.displayName|split(' ')|first }} →</a></div></section>
<nav aria-label="Previous and next stories" class="grid gap-5 border-y border-line py-6 sm:grid-cols-2">{% for item in [{article: previous, label: 'Previous story'}, {article: next, label: 'Next story'}] %}{% if item.article %}<a class="group" href="{{ path('front_article', {slug: item.article.slug}) }}"><p class="eyebrow">{{ item.label }}</p><p class="mt-3 font-display text-xl group-hover:text-brand">{{ item.article.title }}</p></a>{% else %}<span></span>{% endif %}{% endfor %}</nav>
{% include 'front/article/comments.html.twig' %}
</div></div>
<section class="mt-16 border-t border-line pt-12"><p class="eyebrow">Keep your curiosity going</p><h2 class="section-title mt-3 mb-8">You might also enjoy</h2><div class="grid gap-7 sm:grid-cols-2 lg:grid-cols-3">{% for relatedArticle in related %}<twig:ArticleCard article="{{ relatedArticle }}"/>{% endfor %}</div></section>
</article>{% endblock %}
