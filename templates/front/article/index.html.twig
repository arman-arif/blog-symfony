{% extends 'front/layout.html.twig' %}
{% block title %}{{ article.title }} · Fieldnotes{% endblock %}
{% block content %}<article class="container-editorial py-12"><div class="mx-auto max-w-4xl"><twig:Breadcrumbs items="{{ [{label: 'Journal', href: path('front_blog')}, {label: article.categories[0].name}] }}"/><p class="eyebrow mt-8">{{ article.categories[0].name }}</p><h1 class="mt-4 font-display text-4xl font-medium leading-tight sm:text-6xl">{{ article.title }}</h1><p class="mt-5 text-lg text-muted">{{ article.subtitle }}</p><div class="my-8 flex items-center gap-3"><twig:Avatar name="{{ article.author.displayName }}"/><div><p class="text-sm font-semibold">{{ article.author.displayName }}</p><p class="mt-1 text-xs text-muted">{{ article.publishedAt|date('F j, Y') }} · {{ article.readingTime }} min read</p></div></div><figure><img src="{{ asset(article.featuredImage.url) }}" alt="{{ article.featuredImage.alt }}" width="1200" height="800" loading="lazy" class="w-full rounded-card"><figcaption class="mt-3 text-xs text-muted">{{ article.featuredImage.caption }}</figcaption></figure><div class="prose mt-10 max-w-none"><p>{{ article.excerpt }}</p><p>It starts with a simple question: what are we really paying attention to? Making space for a considered response can change the way we approach a project, a conversation or an ordinary afternoon.</p></div></div></article>{% endblock %}
