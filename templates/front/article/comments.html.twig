{% macro thread(comment, depth = 0) %}
<div class="{{ depth ? 'ml-4 border-l border-line pl-4 sm:ml-8' : 'card p-5' }}" data-comment-id="{{ comment.id }}"><div class="flex items-center gap-3"><twig:Avatar name="{{ comment.guestName }}" size="sm"/><div><p class="text-sm font-semibold">{{ comment.guestName }}</p><time class="text-xs text-muted" datetime="{{ comment.createdAt|date('c') }}">{{ comment.createdAt|date('M j, Y') }}</time></div></div><p class="mt-4 text-sm leading-7 text-muted">{{ comment.content }}</p><twig:Button variant="ghost" size="sm" class="mt-2" data-reply-to="{{ comment.id }}" data-reply-name="{{ comment.guestName }}">Reply</twig:Button><div class="mt-4 space-y-5" data-replies>{% for reply in comment.replies|filter(c => c.status == 'approved') %}{{ _self.thread(reply, depth + 1) }}{% endfor %}</div></div>
{% endmacro %}
<section class="mt-12" aria-labelledby="comments-heading"><h2 id="comments-heading" class="section-title">Join the conversation</h2><p class="mt-3 text-sm text-muted">Thoughtful replies make good stories even better. Be kind. Stay curious.</p>
{% if article.allowComments %}<div class="mt-7 space-y-5" data-comments>{% for comment in comments|filter(c => c.status == 'approved') %}{{ _self.thread(comment) }}{% endfor %}</div><form class="card mt-7 space-y-5 p-6" data-comment-form data-component="validate" data-success-message="Comment added to this page preview only. Nothing was submitted for publication."><div data-reply-context hidden class="flex items-center justify-between gap-3 rounded-control bg-brand/10 p-3 text-sm">Replying to <span data-reply-name></span><twig:Button variant="ghost" size="sm" data-cancel-reply>Cancel</twig:Button></div><div class="grid gap-5 sm:grid-cols-2"><twig:Field id="comment-name" label="Your name" required><twig:Input id="comment-name" required maxlength="80" autocomplete="name"/></twig:Field><twig:Field id="comment-email" label="Email (never displayed)" required><twig:Input id="comment-email" type="email" required autocomplete="email"/></twig:Field></div><twig:Field id="comment-content" label="Your thoughts" help="Keep it thoughtful. Preview comments stay only on this page." required><twig:Textarea id="comment-content" required minlength="10" maxlength="2000"/></twig:Field><twig:Button type="submit">Post preview comment<twig:Icon name="arrow"/></twig:Button></form>
{% else %}<twig:Alert tone="info" title="Comments are closed" class="mt-6">The conversation is paused on this story. You can still share it with someone who might enjoy it.</twig:Alert>{% endif %}
</section>
