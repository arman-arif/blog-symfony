{% extends 'front/layout.html.twig' %}
{% block title %}{{ setting('general.name') }} · {{ setting('general.tagline') }}{% endblock %}
{% block content %}
{% set sections = setting('appearance.homepage_sections') %}
{% for section in sections %}
    {% include 'front/home/_' ~ section ~ '.html.twig' ignore missing %}
{% endfor %}
{% endblock %}
