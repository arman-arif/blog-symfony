{% extends 'front/layout.html.twig' %}
{% block title %}Fieldnotes · A place for curious minds{% endblock %}
{% block content %}
<div class="container-editorial">
<section class="border-b border-line py-12 sm:py-16"><div class="mb-10 flex flex-col justify-between gap-5 md:flex-row md:items-end"><div><p class="eyebrow">Ideas for a more considered life</p><h1 class="mt-4 font-display text-display">Stay curious.<br>Live considered.</h1></div><p class="max-w-sm pb-2 text-sm leading-7 text-muted">Stories that make you pause, perspectives that stay with you. A little inspiration for the everyday.</p></div><twig:ArticleCard article="{{ articles[0] }}" variant="large"/></section>
<section id="latest" class="scroll-mt-24 py-12 sm:py-16"><div class="mb-8 flex items-end justify-between gap-4"><div><p class="eyebrow">Fresh from the journal</p><h2 class="section-title mt-3">The latest stories</h2></div><a href="{{ path('front_blog') }}" class="inline-flex items-center gap-2 text-sm font-semibold text-brand">View all<twig:Icon name="arrow"/></a></div><div class="grid gap-x-7 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">{% for article in articles|slice(1, 6) %}<twig:ArticleCard article="{{ article }}"/>{% endfor %}</div></section>
<section class="grid gap-12 border-y border-line py-12 sm:py-16 lg:grid-cols-2"><div><p class="eyebrow">Reader favourites</p><h2 class="section-title mt-3 mb-6">Worth your time</h2>{% for article in popular|slice(0, 3) %}<twig:ArticleCard article="{{ article }}" variant="minimal"/>{% endfor %}</div><div><p class="eyebrow">In the conversation</p><h2 class="section-title mt-3 mb-6">Trending now</h2><div class="space-y-7">{% for article in articles|slice(7, 3) %}<twig:ArticleCard article="{{ article }}" variant="horizontal"/>{% endfor %}</div></div></section>
<section id="categories" class="scroll-mt-24 py-12 sm:py-16"><div class="mb-8"><p class="eyebrow">Follow your curiosity</p><h2 class="section-title mt-3">Find your corner of the world</h2></div><div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">{% for category in categories|slice(0, 4) %}<a class="card group flex items-center justify-between gap-4 p-6 transition-colors hover:border-brand" href="{{ path('front_blog', {category: category.slug}) }}"><div><h3 class="font-display text-2xl">{{ category.name }}</h3><p class="mt-2 text-xs text-muted">{{ category.articleCount }} stories to explore</p></div><twig:Icon name="arrow" class="text-brand"/></a>{% endfor %}</div></section>
{% for category in categories|slice(0, 2) %}<section class="border-t border-line py-12"><div class="mb-8 flex justify-between gap-4"><h2 class="section-title">A fresh perspective on {{ category.name|lower }}</h2><a href="{{ path('front_blog', {category: category.slug}) }}" class="inline-flex items-center gap-2 text-sm font-semibold text-brand">Explore<twig:Icon name="arrow"/></a></div><div class="grid gap-7 md:grid-cols-2">{% for article in articles|filter(a => a.categories[0].id == category.id)|slice(0, 2) %}<twig:ArticleCard article="{{ article }}" variant="horizontal"/>{% endfor %}</div></section>{% endfor %}
<section class="border-t border-line py-12 sm:py-16"><p class="eyebrow">Picked for curious minds</p><h2 class="section-title mt-3 mb-8">A few we think you'll love</h2><div class="grid gap-7 md:grid-cols-3">{% for article in articles|slice(15, 3) %}<twig:ArticleCard article="{{ article }}" variant="compact"/>{% endfor %}</div></section>
<section class="border-t border-line py-12 sm:py-16"><p class="eyebrow">The people behind the perspectives</p><h2 class="section-title mt-3 mb-8">Meet our storytellers</h2><div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{% for author in authors|slice(0, 3) %}<a href="{{ path('front_blog', {author: author.slug}) }}" class="card flex items-center gap-4 p-5 hover:border-brand"><twig:Avatar name="{{ author.displayName }}"/><div><h3 class="text-sm font-semibold">{{ author.displayName }}</h3><p class="mt-1 text-xs text-muted">{{ author.jobTitle }}</p></div><twig:Icon name="arrow" class="ml-auto text-brand"/></a>{% endfor %}</div></section>
</div>
{% endblock %}
