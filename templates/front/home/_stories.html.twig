<div class="container-editorial">
{% for category in categories|slice(0, 2) %}<section class="border-t border-line py-12"><div class="mb-8 flex justify-between gap-4"><h2 class="section-title">A fresh perspective on {{ category.name|lower }}</h2><a href="{{ path('front_blog', {category: category.slug}) }}" class="inline-flex items-center gap-2 text-sm font-semibold text-brand">Explore<twig:Icon name="arrow"/></a></div><div class="grid gap-7 md:grid-cols-2">{% for article in articles|filter(a => a.categories|first and a.categories|first.id == category.id)|slice(0, 2) %}<twig:ArticleCard article="{{ article }}" variant="horizontal"/>{% endfor %}</div></section>{% endfor %}
</div>
