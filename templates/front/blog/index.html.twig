{% extends 'front/layout.html.twig' %}
{% block title %}The journal · Fieldnotes{% endblock %}
{% block content %}
<div class="container-editorial py-12 sm:py-16" data-component="listing">
<twig:Breadcrumbs items="{{ [{label: 'Home', href: path('front_home')}, {label: listingRoute == 'front_search' ? 'Search' : 'Journal'}] }}"/>
{% block listing_heading %}<p class="eyebrow mt-8">The journal</p><h1 class="mt-4 font-display text-display">A world of ideas.</h1><p class="mt-5 max-w-xl text-muted">Fresh perspectives on design, technology and the art of living well. Follow your curiosity.</p>{% endblock %}
<div class="my-8 flex flex-wrap gap-2"><a class="btn {{ not filters.category ? 'btn-primary' : 'btn-secondary' }} btn-sm" href="{{ path(listingRoute, filters|merge({category: '', page: 1})) }}">All stories</a>{% for category in categories|slice(0, 6) %}<a class="btn {{ filters.category == category.slug ? 'btn-primary' : 'btn-secondary' }} btn-sm" href="{{ path(listingRoute, filters|merge({category: category.slug, page: 1})) }}" {% if filters.category == category.slug %}aria-current="true"{% endif %}>{{ category.name }}</a>{% endfor %}</div>
<form action="{{ path(listingRoute) }}" method="get" class="card mb-8 grid items-end gap-4 p-5 sm:grid-cols-2 lg:grid-cols-[2fr_1fr_1fr_auto]">
<twig:Field id="journal-search" label="Search stories"><twig:Input id="journal-search" name="q" type="search" value="{{ filters.q }}" placeholder="Find an idea, a topic, a new perspective…"/></twig:Field>
{% set tagOptions = {'': 'All tags'} %}{% for tag in tags %}{% set tagOptions = tagOptions|merge({(tag.slug): tag.name}) %}{% endfor %}
<twig:Field id="journal-tag" label="Topic"><twig:Select id="journal-tag" name="tag" options="{{ tagOptions }}" value="{{ filters.tag }}"/></twig:Field>
<twig:Field id="journal-sort" label="Sort by"><twig:Select id="journal-sort" name="sort" options="{{ {latest: 'Newest first', popular: 'Most popular', oldest: 'Oldest first'} }}" value="{{ filters.sort }}"/></twig:Field>
<input type="hidden" name="category" value="{{ filters.category }}"><input type="hidden" name="author" value="{{ filters.author }}"><twig:Button type="submit">Apply filters</twig:Button>
</form>
<div class="mb-7 flex items-center justify-between gap-3"><p class="text-sm text-muted"><span class="font-semibold text-ink">{{ total }}</span> {{ total == 1 ? 'story' : 'stories' }}{% if filters.q %} matching “{{ filters.q }}”{% endif %}{% if filters.author %} by {{ filters.author|replace({'-': ' '})|title }}{% endif %}</p><div class="flex gap-1" role="group" aria-label="Article layout"><twig:Button variant="secondary" size="icon" data-view-button="grid" aria-label="Grid view" aria-pressed="true"><twig:Icon name="grid"/></twig:Button><twig:Button variant="secondary" size="icon" data-view-button="list" aria-label="List view" aria-pressed="false"><twig:Icon name="list"/></twig:Button></div></div>
{% if articles %}<div data-results data-view="grid" class="article-results grid gap-x-7 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">{% for article in articles %}<twig:ArticleCard article="{{ article }}"/>{% endfor %}</div>{% else %}<twig:EmptyState title="{{ filters.q ? 'No matches this time' : 'No stories in this collection yet' }}" description="Try a different phrase or clear your filters. There’s still plenty to discover."><twig:Button href="{{ path(listingRoute) }}">Clear filters<twig:Icon name="arrow"/></twig:Button></twig:EmptyState>{% endif %}
<twig:Pagination route="{{ listingRoute }}" page="{{ page }}" pages="{{ pages }}" query="{{ filters }}"/>
</div>{% endblock %}
