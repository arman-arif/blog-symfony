{% extends 'front/layout.html.twig' %}
{% block title %}The journal · Fieldnotes{% endblock %}
{% block content %}<div class="container-editorial py-12 sm:py-16"><p class="eyebrow">The journal</p><h1 class="mt-4 font-display text-display">A world of ideas.</h1><p class="mt-5 text-muted">{{ total }} stories for a curious mind.</p><div class="my-8 flex flex-wrap gap-2"><a class="btn btn-secondary btn-sm" href="{{ path('front_blog') }}">All stories</a>{% for category in categories|slice(0, 6) %}<a class="btn {{ filters.category == category.slug ? 'btn-primary' : 'btn-secondary' }} btn-sm" href="{{ path('front_blog', {category: category.slug}) }}">{{ category.name }}</a>{% endfor %}</div>{% if articles %}<div class="grid gap-x-7 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">{% for article in articles %}<twig:ArticleCard article="{{ article }}"/>{% endfor %}</div>{% else %}<twig:EmptyState title="No stories found"><twig:Button href="{{ path('front_blog') }}">Browse all stories</twig:Button></twig:EmptyState>{% endif %}<twig:Pagination route="front_blog" page="{{ page }}" pages="{{ pages }}" query="{{ filters }}"/></div>{% endblock %}
