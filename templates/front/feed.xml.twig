<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
    <channel>
        <title>{{ title }}</title>
        <link>{{ url('front_home') }}</link>
        <description>{{ description }}</description>
        <language>en</language>
        <atom:link href="{{ url('front_feed') }}" rel="self" type="application/rss+xml"/>
        {% for article in articles %}
            <item>
                <title>{{ article.title }}</title>
                <link>{{ url('front_article', {slug: article.slug}) }}</link>
                <guid isPermaLink="true">{{ url('front_article', {slug: article.slug}) }}</guid>
                <pubDate>{{ article.publishedAt|date('r') }}</pubDate>
                <description>{{ article.excerpt ?: article.seo.description ?: '' }}</description>
                {% for category in article.categories %}<category>{{ category.name }}</category>{% endfor %}
            </item>
        {% endfor %}
    </channel>
</rss>
