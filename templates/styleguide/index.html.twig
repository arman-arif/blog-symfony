{% extends 'base.html.twig' %}
{% block title %}Fieldnotes · Design system{% endblock %}
{% block body %}
<header class="container-editorial flex items-center justify-between border-b border-line py-6"><a class="font-display text-3xl" href="{{ path('front_home') }}">fieldnotes<span class="text-accent">.</span></a><twig:Button variant="secondary" data-component="theme" aria-pressed="false"><twig:Icon name="sun"/>Dark mode</twig:Button></header>
<main id="main-content" class="container-editorial space-y-12 py-12">
<div><p class="eyebrow">M1.1 / Visual foundations</p><h1 class="mt-3 font-display text-display">Thoughtful by design.</h1><p class="mt-4 max-w-2xl text-muted">Warm paper, forest green, editorial typography. Accessible components for a quieter, more considered reading experience.</p></div>
<section aria-labelledby="tokens-title"><h2 id="tokens-title" class="section-title mb-6">01 — Color & type</h2><div class="grid grid-cols-2 gap-4 md:grid-cols-6">{% for name, color in {Forest: 'bg-brand text-surface dark:text-canvas', Terracotta: 'bg-accent text-white dark:text-canvas', Paper: 'bg-canvas text-ink', Surface: 'bg-surface text-ink', Ink: 'bg-ink text-canvas', Muted: 'bg-muted text-surface dark:text-canvas'} %}<div class="rounded-card border border-line p-6 {{ color }}">{{ name }}</div>{% endfor %}</div><p class="mt-6 font-display text-4xl">Newsreader: stories worth slowing down for.</p><p class="mt-3 text-sm text-muted">DM Sans: readable navigation, labels and controls. 4px spacing scale · 8px controls · 16px cards.</p></section>
<section aria-labelledby="buttons-title"><h2 id="buttons-title" class="section-title mb-6">02 — Buttons & feedback</h2><div class="flex flex-wrap gap-3">{% for variant in ['primary', 'secondary', 'ghost', 'danger'] %}<twig:Button variant="{{ variant }}">{{ variant|capitalize }}</twig:Button>{% endfor %}<twig:Button size="sm">Small</twig:Button><twig:Button size="lg">Large</twig:Button><twig:Button loading>Working…</twig:Button><twig:Button disabled>Disabled</twig:Button><twig:Tooltip text="An accessible helper"><twig:Button variant="secondary" aria-label="Help: accessible helper">?</twig:Button></twig:Tooltip></div><div class="mt-6 flex flex-wrap gap-3">{% for tone in ['neutral', 'success', 'warning', 'danger', 'info'] %}<twig:Badge tone="{{ tone }}">{{ tone|capitalize }}</twig:Badge>{% endfor %}</div><div class="mt-6 grid gap-4 md:grid-cols-2">{% for tone, message in {success: 'Your changes are ready for review.', info: 'This is a preview with realistic mock data.', warning: 'A scheduled article needs a publication date.', danger: 'We could not load this content. Try again.'} %}<twig:Alert tone="{{ tone }}" title="{{ tone|capitalize }}">{{ message }}</twig:Alert>{% endfor %}</div></section>
<section aria-labelledby="forms-title"><h2 id="forms-title" class="section-title mb-6">03 — Form controls</h2><p class="mb-4 text-sm text-muted">Local-only preview. These forms never save or send data.</p><twig:PreviewForm class="card p-6" fieldsClass="grid gap-6 md:grid-cols-2" successMessage="All fields validated. This styleguide does not save data.">
<twig:Field id="demo-name" label="Display name" help="How your name appears to readers." required><twig:Input id="demo-name" required placeholder="Maya Chen" autocomplete="name"/></twig:Field>
<twig:Field id="demo-email" label="Email address" error="Enter a valid email address." required><twig:Input id="demo-email" type="email" value="not-an-email" invalid required autocomplete="email"/></twig:Field>
<twig:Field id="demo-category" label="Category"><twig:Select id="demo-category" options="{{ {design: 'Design', technology: 'Technology', culture: 'Culture'} }}"/></twig:Field>
<twig:Field id="demo-disabled" label="Disabled input" help="Unavailable until email is verified."><twig:Input id="demo-disabled" value="Awaiting verification" disabled/></twig:Field>
<twig:Field id="demo-bio" label="Biography" help="A few sentences about your work."><twig:Textarea id="demo-bio" placeholder="Tell your story…"/></twig:Field>
<div class="space-y-3"><twig:Choice id="demo-check" label="Allow comments" checked/><br><twig:Choice id="demo-radio-one" name="demo-role" type="radio" label="Editor" checked/><twig:Choice id="demo-radio-two" name="demo-role" type="radio" label="Author"/><br><twig:Choice id="demo-toggle" type="toggle" label="Email notifications" checked/></div>
<twig:Button type="submit">Validate preview</twig:Button>
</twig:PreviewForm></section>
<section aria-labelledby="navigation-title"><h2 id="navigation-title" class="section-title mb-6">04 — Navigation & overlays</h2><twig:Breadcrumbs items="{{ [{label: 'Home', href: path('front_home')}, {label: 'Design system'}] }}"/><div class="my-6 flex flex-wrap gap-3"><twig:Dropdown id="demo-dropdown" label="Actions"><a class="dropdown-item" href="#forms-title">Edit details</a><a class="dropdown-item" href="#cards-title">Browse cards</a></twig:Dropdown><twig:Button data-dialog-open="demo-modal">Open modal</twig:Button><twig:Button variant="secondary" data-dialog-open="demo-drawer">Open drawer</twig:Button><twig:Button variant="danger" data-component="confirm" data-confirm-message="Remove the sample article from this preview?">Delete confirmation</twig:Button></div>
<twig:Tabs id="demo-tabs" tabs="{{ {overview: 'Overview', details: 'Details', history: 'History'} }}">{% for key, copy in {overview: 'A consistent visual language, from reading to publishing.', details: 'Keyboard support: arrow keys change tabs. Dialogs trap focus and Escape closes them.', history: 'Every milestone is verified and committed separately.'} %}<div id="demo-tabs-{{ key }}" role="tabpanel" aria-labelledby="demo-tabs-{{ key }}-tab" tabindex="0" class="card mt-4 p-6" {% if not loop.first %}hidden{% endif %}>{{ copy }}</div>{% endfor %}</twig:Tabs>
<twig:Pagination route="styleguide" page="1" pages="3"/>
</section>
<section id="cards-title" aria-labelledby="cards-heading"><h2 id="cards-heading" class="section-title mb-6">05 — Cards, tables & states</h2><div class="grid gap-6 md:grid-cols-3"><twig:Card title="A human touch"><twig:Avatar name="{{ authors[0].displayName }}"/><p class="mt-4 text-sm text-muted">{{ authors[0].bio }}</p></twig:Card><twig:Skeleton/><twig:EmptyState title="No articles found" description="Change your search or start a fresh story."/></div><div class="mt-6"><twig:Table caption="Sample editorial queue" columns="{{ ['Article', 'Author', 'Status'] }}">{% for article in articles|slice(0, 4) %}<tr><td class="font-semibold">{{ article.title }}</td><td>{{ article.author.displayName }}</td><td><twig:Badge tone="success">Published</twig:Badge></td></tr>{% endfor %}</twig:Table></div><twig:Alert tone="warning" title="No permission" class="mt-6">You do not have permission to publish articles. Ask an editor to review your draft.</twig:Alert></section>
<section aria-labelledby="admin-patterns-title"><h2 id="admin-patterns-title" class="section-title mb-6">06 — Editorial form pattern</h2><twig:PreviewForm successMessage="Form pattern validated locally. Nothing was saved."><twig:AdminFormLayout sidebarTitle="Editorial settings"><twig:Field id="pattern-title" label="Working title" help="A main column for content and a separate settings panel."><twig:Input id="pattern-title" name="title" required minlength="5"/></twig:Field><twig:Field id="pattern-excerpt" label="Excerpt" class="mt-5"><twig:Textarea id="pattern-excerpt" name="excerpt"/></twig:Field><twig:Button type="submit" class="mt-5">Validate preview</twig:Button><twig:block name="sidebar"><twig:Field id="pattern-status" label="Status"><twig:Select id="pattern-status" options="{{ {draft: 'Draft', pending_review: 'Pending review'} }}"/></twig:Field><p class="mt-5 text-xs text-muted">Preview only. No records are created.</p></twig:block></twig:AdminFormLayout></twig:PreviewForm></section>
</main>
<twig:Modal id="demo-modal" title="Article details"><p class="text-sm text-muted">Use Tab to move through the controls. The page behind this dialog is inert. Nothing is saved or sent.</p><twig:PreviewForm class="mt-6"><twig:Field id="modal-title" label="Article title" required><twig:Input id="modal-title" required/></twig:Field><twig:Button type="submit">Validate & show toast</twig:Button></twig:PreviewForm></twig:Modal>
<twig:Modal id="demo-drawer" title="Reading list" drawer><twig:EmptyState title="Your next great read" description="Saved stories will be waiting here."/></twig:Modal>
{% endblock %}
