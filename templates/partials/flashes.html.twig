{% for type, messages in app.flashes %}
    {% for message in messages %}
        <div class="container-editorial mt-4">
            <div class="alert alert-{{ type == 'error' ? 'danger' : type }}" role="{{ type == 'danger' ? 'alert' : 'status' }}">
                <twig:Icon name="{{ type == 'success' ? 'check' : (type == 'danger' ? 'alert' : 'mail') }}"/>
                <p>{{ message }}</p>
            </div>
        </div>
    {% endfor %}
{% endfor %}
