<div class="fixed bottom-5 right-5 z-50 flex max-h-[80vh] w-[calc(100%-2.5rem)] max-w-sm flex-col gap-3 overflow-y-auto" data-component="toast" role="region" aria-label="Notifications" aria-live="polite" aria-relevant="additions"></div>
<twig:Modal id="confirmation-dialog" title="Confirm removal">
    <p data-confirm-message class="text-sm text-muted">Are you sure?</p>
    <div class="mt-6 flex justify-end gap-3"><twig:Button variant="secondary" data-dialog-close>Cancel</twig:Button><twig:Button variant="danger" data-confirm-action>Confirm</twig:Button></div>
</twig:Modal>
