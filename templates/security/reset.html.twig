{% extends 'security/layout.html.twig' %}
{% block title %}Choose a new password · Fieldnotes{% endblock %}
{% block page_title %}Choose a new password{% endblock %}
{% block eyebrow %}Account recovery{% endblock %}
{% block heading %}A fresh start.{% endblock %}
{% block intro %}Choose a strong password with at least 10 characters.{% endblock %}
{% block content %}
{{ form_start(form, {action: path('app_reset_password', {token: token})}) }}
{{ form_row(form.plainPassword.first) }}
{{ form_row(form.plainPassword.second) }}
<twig:Button type="submit" class="w-full">Save new password</twig:Button>
{{ form_end(form) }}
{% endblock %}
