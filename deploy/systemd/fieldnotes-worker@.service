[Unit]
Description=Fieldnotes async Messenger worker (instance %i)
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=fieldnotes
Group=www-data
WorkingDirectory=/var/www/fieldnotes
Environment=APP_ENV=prod
Environment=APP_DEBUG=0
Environment=MESSENGER_CONSUMER_NAME=fieldnotes-%H-%i
# Symfony reads the shared, group-readable /var/www/fieldnotes/.env.local.
# The instance identifies a process, not a transport (async-2 does not exist).
ExecStart=/usr/bin/php /var/www/fieldnotes/bin/console messenger:consume async --time-limit=3600 --memory-limit=256M
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
